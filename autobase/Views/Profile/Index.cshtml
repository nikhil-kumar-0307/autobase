@model autobase.Models.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<style>
    .profile-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 20px;
        align-items: start;
    }

    /* ── Profile Card ── */
    .profile-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        text-align: center;
    }

    .profile-card-banner {
        height: 80px;
        background: linear-gradient(135deg, #F5C518 0%, #d4a90e 100%);
    }

    .profile-card-body {
        padding: 0 24px 28px;
    }

    .profile-avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #111;
        border: 4px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        font-weight: 800;
        color: #F5C518;
        margin: -36px auto 14px;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .profile-name {
        font-size: 17px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 4px;
    }

    .profile-emp {
        font-size: 12px;
        color: var(--muted);
        font-family: monospace;
        margin-bottom: 12px;
    }

    .profile-role-pill {
        display: inline-flex;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .pill-superadmin {
        background: rgba(245,197,24,0.15);
        color: #92700a;
    }

    .pill-admin {
        background: rgba(168,85,247,0.1);
        color: #9333ea;
    }

    .pill-driver {
        background: rgba(59,130,246,0.1);
        color: #2563eb;
    }

    .pill-employee {
        background: rgba(34,197,94,0.1);
        color: #16a34a;
    }

    .profile-info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        border-top: 1px solid var(--border);
        font-size: 13px;
    }

    .profile-info-label {
        color: var(--muted);
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .profile-info-value {
        color: var(--text);
        font-weight: 600;
        font-family: monospace;
        font-size: 13px;
    }

    /* ── Right Column ── */
    .form-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 16px;
    }

    .form-card-header {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border);
        background: var(--bg);
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .form-card-header svg {
            width: 16px;
            height: 16px;
            stroke: var(--accent-dark);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .form-card-header span {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
        }

    .form-card-body {
        padding: 24px;
    }

    .form-card-footer {
        padding: 16px 24px;
        border-top: 1px solid var(--border);
        background: var(--bg);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
        margin-bottom: 18px;
    }

        .form-group:last-child {
            margin-bottom: 0;
        }

    .form-label {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--muted);
    }

    .form-control {
        height: 44px;
        padding: 0 14px;
        background: #fff;
        border: 1.5px solid #dde1ea;
        border-radius: 10px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        color: var(--text);
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
        width: 100%;
    }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(245,197,24,0.15);
        }

        .form-control:read-only {
            background: var(--bg);
            color: var(--muted);
            cursor: not-allowed;
        }

        .form-control::placeholder {
            color: #c0c6d4;
        }

    .pw-wrap {
        position: relative;
    }

        .pw-wrap .form-control {
            padding-right: 44px;
        }

    .pw-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: var(--muted);
        display: flex;
        align-items: center;
        transition: color 0.15s;
    }

        .pw-toggle:hover {
            color: var(--text);
        }

        .pw-toggle svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .field-error {
        font-size: 12px;
        color: var(--danger);
    }

    .btn-save {
        height: 42px;
        padding: 0 28px;
        background: var(--accent);
        border: none;
        border-radius: 9px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #111;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-save:hover {
            background: var(--accent-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(245,197,24,0.35);
        }

        .btn-save svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .alert-success {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f0fff4;
        border: 1px solid #9ae6b4;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 13px;
        color: #276749;
        margin-bottom: 20px;
        font-weight: 500;
    }

    .alert-error {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff5f5;
        border: 1px solid #fed7d7;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 13px;
        color: #c53030;
        margin-bottom: 20px;
        font-weight: 500;
    }

    @@media (max-width: 860px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ab-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="ab-main">
        @await Html.PartialAsync("_AdminTopbar")
        <div class="ab-content">

            <div class="page-header">
                <div class="page-title">My Profile</div>
                <div class="page-sub">View your account details and manage your password.</div>
            </div>

            @if (TempData["PasswordSuccess"] != null)
            {
                <div class="alert-success">✅ @TempData["PasswordSuccess"]</div>
            }
            @if (TempData["PasswordError"] != null)
            {
                <div class="alert-error">⚠️ @TempData["PasswordError"]</div>
            }

            <div class="profile-grid">

                <!-- ── Left: Profile Card ── -->
                <div>
                    <div class="profile-card">
                        <div class="profile-card-banner"></div>
                        <div class="profile-card-body">
                            <div class="profile-avatar">
                                @Model.Name.Substring(0, 1).ToUpper()
                            </div>
                            <div class="profile-name">@Model.Name</div>
                            <div class="profile-emp">#@Model.EmployeeNumber</div>

                            @{
                                var pillClass = Model.Role switch
                                {
                                    "SuperAdmin" => "pill-superadmin",
                                    "Admin" => "pill-admin",
                                    "Driver" => "pill-driver",
                                    _ => "pill-employee"
                                };
                            }
                            <div><span class="profile-role-pill @pillClass">@Model.Role</span></div>

                            <div class="profile-info-row">
                                <span class="profile-info-label">Mobile</span>
                                <span class="profile-info-value">@Model.MobileNumber</span>
                            </div>
                            <div class="profile-info-row">
                                <span class="profile-info-label">Employee No.</span>
                                <span class="profile-info-value">#@Model.EmployeeNumber</span>
                            </div>
                            <div class="profile-info-row">
                                <span class="profile-info-label">Role</span>
                                <span class="profile-info-value">@Model.Role</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ── Right: Details + Password ── -->
                <div>

                    <!-- Account Details (read-only) -->
                    <div class="form-card">
                        <div class="form-card-header">
                            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            <span>Account Details</span>
                        </div>
                        <div class="form-card-body">
                            <div class="form-group">
                                <label class="form-label">Full Name</label>
                                <input type="text" class="form-control" value="@Model.Name" readonly />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Employee Number</label>
                                <input type="text" class="form-control" value="#@Model.EmployeeNumber" readonly />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Mobile Number</label>
                                <input type="text" class="form-control" value="@Model.MobileNumber" readonly />
                            </div>
                            <div class="form-group">
                                <label class="form-label">Role</label>
                                <input type="text" class="form-control" value="@Model.Role" readonly />
                            </div>
                        </div>
                    </div>

                    <!-- Change Password -->
                    <div class="form-card">
                        <div class="form-card-header">
                            <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            <span>Change Password</span>
                        </div>
                        <form asp-controller="Profile" asp-action="ChangePassword" method="post">
                            <div class="form-card-body">

                                <div class="form-group">
                                    <label class="form-label">Current Password</label>
                                    <div class="pw-wrap">
                                        <input type="password" id="pwCurrent" name="CurrentPassword"
                                               class="form-control" placeholder="Enter current password" />
                                        <button type="button" class="pw-toggle" onclick="togglePw('pwCurrent')">
                                            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                        </button>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">New Password</label>
                                    <div class="pw-wrap">
                                        <input type="password" id="pwNew" name="NewPassword"
                                               class="form-control" placeholder="Min. 4 characters" />
                                        <button type="button" class="pw-toggle" onclick="togglePw('pwNew')">
                                            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                        </button>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Confirm New Password</label>
                                    <div class="pw-wrap">
                                        <input type="password" id="pwConfirm" name="ConfirmPassword"
                                               class="form-control" placeholder="Re-enter new password" />
                                        <button type="button" class="pw-toggle" onclick="togglePw('pwConfirm')">
                                            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                        </button>
                                    </div>
                                </div>

                            </div>
                            <div class="form-card-footer">
                                <button type="submit" class="btn-save">
                                    <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                                    Update Password
                                </button>
                            </div>
                        </form>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePw(id) {
            const i = document.getElementById(id);
            i.type = i.type === 'password' ? 'text' : 'password';
        }
    </script>
}