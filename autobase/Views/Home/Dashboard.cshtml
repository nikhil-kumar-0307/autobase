@model autobase.Models.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
}

<style>
    :root {
        --green: #1d9e75;
        --green-bg: #e1f5ee;
        --blue: #185fa5;
        --blue-bg: #e6f1fb;
        --amber: #ba7517;
        --amber-bg: #faeeda;
        --red: #a32d2d;
        --red-bg: #fcebeb;
        --gray-bg: #f9f8f4;
        --border: #e8e6de;
        --text: #2c2c2a;
        --muted: #888780;
        --radius: 14px;
    }

    body {
        background: #f4f3ee;
        font-family: 'Segoe UI', sans-serif;
        color: var(--text);
    }

    .dash-wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 28px 20px;
    }

    /* ── Top bar ── */
    .dash-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 18px 24px;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .dash-greeting h2 { font-size: 20px; font-weight: 700; margin: 0 0 4px; }
    .dash-greeting p  { font-size: 13px; color: var(--muted); margin: 0; }

    .dash-meta { display: flex; gap: 10px; flex-wrap: wrap; }

    .meta-pill {
        background: var(--gray-bg);
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 5px 14px;
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
    }
    .meta-pill span { color: var(--text); }

    .topbar-right { display: flex; align-items: center; gap: 10px; }

    /* Profile pill button */
    .profile-pill-btn {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px 6px 6px;
        border: 1.5px solid var(--border);
        border-radius: 30px;
        background: #fff;
        cursor: pointer;
        text-decoration: none;
        transition: border-color .15s, box-shadow .15s;
    }
    .profile-pill-btn:hover {
        border-color: var(--green);
        box-shadow: 0 2px 10px rgba(29,158,117,.12);
    }
    .profile-pill-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--green);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 800;
        color: #fff;
        flex-shrink: 0;
    }
    .profile-pill-info { line-height: 1.2; }
    .profile-pill-name { font-size: 12px; font-weight: 700; color: var(--text); }
    .profile-pill-role { font-size: 10px; color: var(--muted); }

    .logout-btn {
        background: var(--red-bg);
        color: var(--red);
        border: 1px solid #f7c1c1;
        border-radius: 8px;
        padding: 8px 18px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background .15s;
    }
    .logout-btn:hover { background: #f9d6d6; color: var(--red); }

    /* ── Alerts ── */
    .flash-success, .flash-error {
        border-radius: 10px;
        padding: 13px 18px;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .flash-success { background: var(--green-bg); color: var(--green); border: 1px solid #9fe1cb; }
    .flash-error   { background: var(--red-bg);   color: var(--red);   border: 1px solid #f7c1c1; }

    /* ── Section title ── */
    .section-title {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    /* ── Vehicle grid ── */
    .vehicle-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px;
        margin-bottom: 36px;
    }

    .vehicle-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
        transition: box-shadow .15s, transform .15s;
    }
    .vehicle-card:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(0,0,0,.07); }

    .vc-top {
        background: var(--green-bg);
        padding: 18px 20px 14px;
        position: relative;
    }
    .vc-type-badge {
        font-size: 10px; font-weight: 700; letter-spacing: .07em;
        text-transform: uppercase;
        background: rgba(29,158,117,.15); color: var(--green);
        padding: 3px 9px; border-radius: 20px;
        display: inline-block; margin-bottom: 8px;
    }
    .vc-name { font-size: 16px; font-weight: 700; color: var(--text); margin: 0 0 4px; }
    .vc-reg  {
        font-family: 'Courier New', monospace; font-size: 12px;
        background: rgba(255,255,255,.7); color: #444441;
        padding: 3px 8px; border-radius: 5px; display: inline-block;
    }
    .vc-avail-dot {
        position: absolute; top: 16px; right: 16px;
        width: 10px; height: 10px; border-radius: 50%;
        background: var(--green); box-shadow: 0 0 0 3px rgba(29,158,117,.25);
    }
    .vc-body { padding: 14px 20px; }
    .vc-detail {
        display: flex; justify-content: space-between;
        font-size: 12px; color: var(--muted); margin-bottom: 6px;
    }
    .vc-detail strong { color: var(--text); font-weight: 600; }

    .request-btn {
        display: block; width: 100%; margin-top: 14px; padding: 10px;
        background: var(--green); color: #fff; border: none; border-radius: 8px;
        font-size: 13px; font-weight: 700; cursor: pointer;
        transition: background .15s; text-align: center;
    }
    .request-btn:hover { background: #0f6e56; }

    /* ── Empty state ── */
    .empty-state {
        text-align: center; padding: 44px 24px; color: var(--muted);
        background: #fff; border: 1px solid var(--border);
        border-radius: var(--radius); margin-bottom: 36px;
    }
    .empty-state .ei { font-size: 40px; margin-bottom: 10px; }
    .empty-state p   { font-size: 14px; margin: 0; }

    /* ── In Use ── */
    .inuse-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 16px; margin-bottom: 36px;
    }
    .inuse-card {
        background: #fff; border: 1px solid var(--border);
        border-radius: var(--radius); overflow: hidden; transition: box-shadow .15s;
    }
    .inuse-card:hover { box-shadow: 0 4px 18px rgba(0,0,0,.06); }
    .vc-top-inuse {
        background: var(--amber-bg); padding: 18px 20px 14px; position: relative;
    }
    .vc-type-badge-inuse {
        font-size: 10px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
        background: rgba(186,117,23,.15); color: var(--amber);
        padding: 3px 9px; border-radius: 20px; display: inline-block; margin-bottom: 8px;
    }
    .vc-avail-dot-inuse {
        position: absolute; top: 16px; right: 16px;
        width: 10px; height: 10px; border-radius: 50%;
        background: var(--amber); box-shadow: 0 0 0 3px rgba(186,117,23,.25);
    }
    .avail-countdown {
        display: block; margin-top: 12px; padding: 8px 12px;
        background: var(--amber-bg); border: 1px solid #f0c97a;
        border-radius: 8px; font-size: 12px; font-weight: 700;
        color: var(--amber); text-align: center;
    }

    /* ── Requests table ── */
    .req-table-wrap {
        background: #fff; border: 1px solid var(--border);
        border-radius: var(--radius); overflow: hidden; margin-bottom: 36px;
    }
    .req-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .req-table thead tr { background: var(--gray-bg); border-bottom: 1px solid var(--border); }
    .req-table th {
        padding: 11px 16px; text-align: left;
        font-size: 10.5px; font-weight: 700;
        letter-spacing: .07em; text-transform: uppercase;
        color: var(--muted); white-space: nowrap;
    }
    .req-table tbody tr { border-bottom: 1px solid #f1efe8; transition: background .12s; }
    .req-table tbody tr:last-child { border-bottom: none; }
    .req-table tbody tr:hover { background: var(--gray-bg); }
    .req-table td { padding: 11px 16px; color: var(--text); vertical-align: middle; }
    .req-reg {
        font-family: 'Courier New', monospace; font-size: 11px;
        background: #f1efe8; padding: 2px 7px; border-radius: 4px; color: #444;
    }
    .status-badge {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;
    }
    .status-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; }
    .sb-pending  { background: var(--amber-bg); color: var(--amber); }
    .sb-pending::before  { background: var(--amber); }
    .sb-approved { background: var(--green-bg); color: var(--green); }
    .sb-approved::before { background: var(--green); }
    .sb-rejected { background: var(--red-bg);   color: var(--red);   }
    .sb-rejected::before { background: var(--red); }
    .sb-completed { background: #f1efe8; color: var(--muted); }
    .sb-completed::before { background: var(--muted); }

    /* ── Modal (shared styles) ── */
    .modal-overlay {
        display: none; position: fixed; inset: 0;
        background: rgba(44,44,42,.45); z-index: 999;
        align-items: center; justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .modal-box {
        background: #fff; border-radius: var(--radius);
        width: 100%; max-width: 460px; margin: 16px; overflow: hidden;
        animation: slideUp .2s ease;
    }
    .modal-box-wide { max-width: 560px; }
    @@keyframes slideUp {
        from { transform: translateY(20px); opacity: 0; }
        to   { transform: translateY(0);    opacity: 1; }
    }
    .modal-header {
        background: var(--green-bg); padding: 18px 22px;
        border-bottom: 1px solid #9fe1cb;
        display: flex; justify-content: space-between; align-items: center;
    }
    .modal-header h5 { font-size: 15px; font-weight: 700; margin: 0; color: var(--text); }
    .modal-close { background: none; border: none; font-size: 20px; color: var(--muted); cursor: pointer; }
    .modal-body  { padding: 22px; }
    .modal-vehicle-info {
        background: var(--gray-bg); border: 1px solid var(--border);
        border-radius: 10px; padding: 12px 16px; margin-bottom: 18px; font-size: 13px;
    }
    .modal-vehicle-info strong { font-size: 15px; display: block; margin-bottom: 4px; }

    .form-group { margin-bottom: 16px; }
    .form-group label {
        display: block; font-size: 12px; font-weight: 700;
        color: var(--muted); margin-bottom: 6px;
        letter-spacing: .05em; text-transform: uppercase;
    }
    .form-group input,
    .form-group textarea {
        width: 100%; padding: 10px 13px;
        border: 1px solid var(--border); border-radius: 8px;
        font-size: 13px; color: var(--text); background: #fff;
        box-sizing: border-box; outline: none; transition: border-color .15s;
    }
    .form-group input:focus,
    .form-group textarea:focus { border-color: var(--green); }
    .form-group input[readonly] { background: var(--gray-bg); color: var(--muted); cursor: not-allowed; }

    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .duration-display {
        background: var(--green-bg); border: 1px solid #9fe1cb;
        border-radius: 8px; padding: 10px 14px; font-size: 13px;
        font-weight: 700; color: var(--green); margin-bottom: 16px; text-align: center;
    }
    .submit-btn {
        width: 100%; padding: 12px; background: var(--green); color: #fff;
        border: none; border-radius: 8px; font-size: 14px; font-weight: 700;
        cursor: pointer; transition: background .15s;
    }
    .submit-btn:hover { background: #0f6e56; }

    /* ── Profile modal specific ── */
    .profile-modal-header {
        background: linear-gradient(135deg, #1d9e75 0%, #0f6e56 100%);
        padding: 0;
        border-bottom: none;
    }
    .profile-modal-banner {
        padding: 28px 22px 50px;
        position: relative;
    }
    .profile-modal-banner h5 {
        font-size: 15px; font-weight: 700; margin: 0; color: #fff;
    }
    .profile-modal-banner p { font-size: 12px; color: rgba(255,255,255,.7); margin: 4px 0 0; }
    .profile-modal-close {
        position: absolute; top: 16px; right: 16px;
        background: rgba(255,255,255,.2); border: none;
        border-radius: 50%; width: 28px; height: 28px;
        font-size: 16px; color: #fff; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
    }
    .profile-avatar-wrap {
        display: flex; align-items: flex-end;
        padding: 0 22px; margin-top: -30px; margin-bottom: 16px; gap: 14px;
    }
    .profile-avatar-circle {
        width: 60px; height: 60px; border-radius: 50%;
        background: #fff; border: 3px solid #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 22px; font-weight: 800; color: var(--green);
        box-shadow: 0 4px 14px rgba(0,0,0,.12); flex-shrink: 0;
    }
    .profile-avatar-info { padding-bottom: 4px; }
    .profile-avatar-name { font-size: 16px; font-weight: 700; color: var(--text); }
    .profile-avatar-emp  { font-size: 12px; color: var(--muted); font-family: monospace; }

    .profile-role-pill {
        display: inline-flex; padding: 3px 12px; border-radius: 20px;
        font-size: 11px; font-weight: 700; margin-bottom: 16px; margin-left: 22px;
    }
    .pill-superadmin { background: rgba(245,197,24,.15); color: #92700a; }
    .pill-admin      { background: rgba(168,85,247,.1);  color: #9333ea; }
    .pill-driver     { background: rgba(59,130,246,.1);  color: #2563eb; }
    .pill-employee   { background: rgba(29,158,117,.1);  color: #1d9e75; }

    .profile-tabs {
        display: flex; border-bottom: 1px solid var(--border);
        padding: 0 22px; gap: 0;
    }
    .profile-tab {
        padding: 10px 18px; font-size: 13px; font-weight: 600;
        color: var(--muted); border-bottom: 2px solid transparent;
        cursor: pointer; transition: color .15s, border-color .15s;
        margin-bottom: -1px; background: none; border-top: none;
        border-left: none; border-right: none;
    }
    .profile-tab.active { color: var(--green); border-bottom-color: var(--green); }
    .profile-tab-content { display: none; padding: 20px 22px; }
    .profile-tab-content.active { display: block; }

    .info-row {
        display: flex; align-items: center; justify-content: space-between;
        padding: 11px 0; border-bottom: 1px solid var(--border); font-size: 13px;
    }
    .info-row:last-child { border-bottom: none; }
    .info-label { font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--muted); }
    .info-value { font-weight: 600; color: var(--text); font-family: monospace; }

    .pw-wrap-modal { position: relative; }
    .pw-wrap-modal input { padding-right: 44px !important; }
    .pw-toggle-modal {
        position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
        background: none; border: none; cursor: pointer; color: var(--muted);
        font-size: 15px; line-height: 1;
    }

    .alert-sm-success {
        background: var(--green-bg); border: 1px solid #9fe1cb;
        border-radius: 8px; padding: 10px 14px;
        font-size: 12px; font-weight: 600; color: var(--green); margin-bottom: 14px;
    }
    .alert-sm-error {
        background: var(--red-bg); border: 1px solid #f7c1c1;
        border-radius: 8px; padding: 10px 14px;
        font-size: 12px; font-weight: 600; color: var(--red); margin-bottom: 14px;
    }
</style>

<div class="dash-wrap">

    @* ── Flash messages ── *@
    @if (TempData["Success"] != null)
    {
        <div class="flash-success">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="flash-error">⚠️ @TempData["Error"]</div>
    }

    @* ── Top bar ── *@
    <div class="dash-topbar">
        <div class="dash-greeting">
            <h2>👋 Welcome back, @Model.UserName</h2>
            <p>Here are the vehicles available for you to request today.</p>
        </div>
        <div class="dash-meta">
            <div class="meta-pill">Emp No: <span>@Model.EmployeeNumber</span></div>
            <div class="meta-pill">Mobile: <span>@Model.Mobile</span></div>
            <div class="meta-pill">Role: <span>@Model.Role</span></div>
        </div>

        <!-- ── Topbar right actions ── -->
        <div class="topbar-right">
            <!-- Profile pill -->
            <button class="profile-pill-btn" onclick="openProfileModal()">
                <div class="profile-pill-avatar">
                    @Model.UserName.Substring(0, 1).ToUpper()
                </div>
                <div class="profile-pill-info">
                    <div class="profile-pill-name">@Model.UserName</div>
                    <div class="profile-pill-role">@Model.Role</div>
                </div>
            </button>
            <!-- Logout -->
            <a asp-controller="Account" asp-action="Logout" class="logout-btn">🚪 Logout</a>
        </div>
    </div>

    @* ── Available Vehicles ── *@
<div class="section-title">🚗 Available Vehicles (@Model.AvailableVehicles.Count)</div>
@if (!Model.AvailableVehicles.Any())
{
    <div class="empty-state"><div class="ei">🚘</div><p>No vehicles are available right now.</p></div>
}
else
{
    @* Build a JS-friendly JSON of all available vehicles *@
    <script>
        const allAvailableVehicles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.AvailableVehicles.Select(v => new {
                v.Id,
                v.VehicleName,
                v.RegistrationNumber,
                v.VehicleType,
                v.Year,
                v.Notes
            })
        ));
    </script>

    <div style="background:#fff;border:1px solid var(--border);border-radius:var(--radius);padding:20px 22px;margin-bottom:24px;">
        <div class="form-row" style="margin-bottom:16px;">
            <div class="form-group" style="margin-bottom:0;">
                <label>Vehicle Type</label>
                <select id="filterType" onchange="filterByType()" 
                        style="width:100%;padding:10px 13px;border:1px solid var(--border);border-radius:8px;font-size:13px;color:var(--text);background:#fff;outline:none;cursor:pointer;">
                    <option value="">— Select a type —</option>
                    @foreach (var type in Model.AvailableVehicles.Select(v => v.VehicleType).Distinct().OrderBy(t => t))
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
                <label>Vehicle Name</label>
                <select id="filterVehicle" onchange="showSelectedVehicle()" disabled
                        style="width:100%;padding:10px 13px;border:1px solid var(--border);border-radius:8px;font-size:13px;color:var(--text);background:#fff;outline:none;cursor:pointer;">
                    <option value="">— Select type first —</option>
                </select>
            </div>
        </div>

        <div id="selectedVehicleCard" style="display:none;">
            <div class="vehicle-card" style="max-width:340px;">
                <div class="vc-top">
                    <div class="vc-avail-dot"></div>
                    <div class="vc-type-badge" id="sv-type"></div>
                    <div class="vc-name" id="sv-name"></div>
                    <div class="vc-reg"  id="sv-reg"></div>
                </div>
                <div class="vc-body">
                    <div class="vc-detail"><span>Year</span><strong id="sv-year"></strong></div>
                    <div class="vc-detail"><span>Status</span><strong style="color:var(--green);">Available</strong></div>
                    <div class="vc-detail" id="sv-notes-row" style="display:none;">
                        <span>Notes</span>
                        <strong id="sv-notes" style="font-size:11px;max-width:140px;text-align:right;"></strong>
                    </div>
                    <button class="request-btn" id="sv-btn" onclick="">+ Request This Vehicle</button>
                </div>
            </div>
        </div>
        <div id="noVehicleHint" style="font-size:13px;color:var(--muted);padding:8px 0;">
            Select a vehicle type to get started.
        </div>
    </div>
}
    @* ── In Use ── *@
<div class="section-title">🔑 In Use (@Model.InUseVehicles.Count)</div>
@if (!Model.InUseVehicles.Any())
{
    <div class="empty-state"><div class="ei">✅</div><p>No vehicles are currently in use.</p></div>
}
else
{
    <div class="inuse-grid">
        @foreach (var v in Model.InUseVehicles)
        {
            var remaining = v.EndTime - DateTime.Now;
            string countdownText;
            string countdownStyle = "";
            if (remaining.TotalMinutes <= 0)
            {
                countdownText = "⚠️ Overdue — should have returned by " + v.EndTime.ToString("hh:mm tt");
                countdownStyle = "background:#fcebeb;border-color:#f7c1c1;color:#a32d2d;";
            }
            else if (remaining.TotalMinutes < 60)
                countdownText = $"⏳ Available in ~{(int)remaining.TotalMinutes} min";
            else if (remaining.TotalHours < 24)
                countdownText = $"⏳ Available at {v.EndTime:hh:mm tt} today";
            else
                countdownText = $"⏳ Available on {v.EndTime:dd MMM} at {v.EndTime:hh:mm tt}";

            // Count how many pending/approved future bookings exist for this vehicle
            int queueCount = Model.MyRequests
                .Count(r => r.VehicleId == v.VehicleId
                         && r.StartTime >= v.EndTime
                         && (r.Status == "Pending" || r.Status == "Approved"));

            <div class="inuse-card">
                <div class="vc-top-inuse">
                    <div class="vc-avail-dot-inuse"></div>
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
                        <div class="vc-type-badge-inuse">@v.VehicleType</div>
                        @if (queueCount > 0)
                        {
                            <span style="font-size:10px;font-weight:700;background:rgba(186,117,23,.2);color:var(--amber);padding:2px 9px;border-radius:20px;">
                                📋 @queueCount in queue
                            </span>
                        }
                    </div>
                    <div class="vc-name">@v.VehicleName</div>
                    <div class="vc-reg">@v.RegistrationNumber</div>
                </div>
                <div class="vc-body">
                    <div class="vc-detail"><span>In use by</span><strong>@v.UserName</strong></div>
                    <div class="vc-detail"><span>Emp No</span><strong>@v.EmployeeNumber</strong></div>
                    <div class="vc-detail"><span>Due back</span><strong style="font-size:11px;">@v.EndTime.ToString("dd MMM, hh:mm tt")</strong></div>
                    <span class="avail-countdown" style="@countdownStyle">@countdownText</span>

                    @* ── Book After Return button ── *@
                    <button
                        onclick="openModalAfterReturn(@v.VehicleId, '@v.VehicleName', '@v.RegistrationNumber', '@v.VehicleType', '@v.EndTime.ToString("yyyy-MM-ddTHH:mm")')"
                        style="display:block;width:100%;margin-top:10px;padding:9px;background:#fff;color:var(--amber);border:1.5px solid var(--amber);border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;transition:background .15s;"
                        onmouseover="this.style.background='var(--amber-bg)'"
                        onmouseout="this.style.background='#fff'">
                        📅 Book After Return (@v.EndTime.ToString("hh:mm tt"))
                    </button>
                </div>
            </div>
        }
    </div>
}
    @* ── My Requests ── *@
    <div class="section-title">📋 My Requests (@Model.MyRequests.Count)</div>
    @if (!Model.MyRequests.Any())
    {
        <div class="empty-state"><div class="ei">📭</div><p>You haven't made any vehicle requests yet.</p></div>
    }
    else
    {
        <div class="req-table-wrap">
            <table class="req-table">
                <thead>
                    <tr>
                        <th>#</th><th>Vehicle</th><th>Reg No</th>
                        <th>Start</th><th>End</th><th>Duration</th>
                        <th>Purpose</th><th>Status</th><th>Admin Notes</th><th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var r in Model.MyRequests)
                    {
                        string sbClass = r.Status.ToLower() switch
                        {
                            "pending"   => "sb-pending",
                            "approved"  => "sb-approved",
                            "rejected"  => "sb-rejected",
                            "completed" => "sb-completed",
                            _           => "sb-pending"
                        };
                        double hrs = (r.EndTime - r.StartTime).TotalHours;
                        string duration = hrs >= 24
                            ? $"{(int)(hrs/24)}d {(int)(hrs%24)}h"
                            : $"{hrs:F1} hrs";

                        <tr>
                            <td style="color:#b4b2a9;font-size:12px;">@i</td>
                            <td style="font-weight:600;">@r.VehicleName</td>
                            <td><span class="req-reg">@r.RegistrationNumber</span></td>
                            <td style="font-size:12px;">@r.StartTime.ToString("dd MMM, hh:mm tt")</td>
                            <td style="font-size:12px;">@r.EndTime.ToString("dd MMM, hh:mm tt")</td>
                            <td style="font-weight:700;color:var(--blue);font-size:12px;">@duration</td>
                            <td style="color:var(--muted);font-size:12px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                @(string.IsNullOrEmpty(r.Purpose) ? "—" : r.Purpose)
                            </td>
                            <td><span class="status-badge @sbClass">@r.Status</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(r.AdminNotes))
                                {
                                    string noteStyle = (r.Status == "Approved" || r.Status == "Completed")
                                        ? "color:var(--green);background:var(--green-bg);border:1px solid #9fe1cb;"
                                        : "color:var(--red);background:var(--red-bg);border:1px solid #f7c1c1;";
                                    <span style="display:inline-block;padding:4px 10px;border-radius:6px;font-size:11px;font-weight:600;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:default;vertical-align:middle;@noteStyle"
                                          title="@r.AdminNotes">💬 @r.AdminNotes</span>
                                }
                                else { <span style="font-size:11px;color:#ccc;">—</span> }
                            </td>
                            <td>
                                @if (r.Status == "Approved")
                                {
                                    <form asp-controller="Home" asp-action="ReturnVehicle" method="post"
                                          onsubmit="return confirm('Are you sure you want to return @r.VehicleName?')">
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" style="background:#e1f5ee;color:#1d9e75;border:1px solid #9fe1cb;border-radius:7px;padding:5px 12px;font-size:11px;font-weight:700;cursor:pointer;white-space:nowrap;">
                                            ✔ Return Vehicle
                                        </button>
                                    </form>
                                }
                                else { <span style="font-size:11px;color:#b4b2a9;">—</span> }
                            </td>
                        </tr>
                        i++;
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ── Request Modal ── *@
<div class="modal-overlay" id="requestModal">
    <div class="modal-box">
        <div class="modal-header">
            <h5 id="modalTitle">🚗 Request Vehicle</h5>
            <button class="modal-close" onclick="closeModal()">✕</button>
        </div>
        <div class="modal-body">
            <div class="modal-vehicle-info">
                <strong id="modalVehicleName">—</strong>
                <span id="modalVehicleReg" style="font-family:monospace;font-size:12px;background:#e8e6de;padding:2px 7px;border-radius:4px;"></span>
                &nbsp;<span id="modalVehicleType" style="font-size:12px;color:var(--muted);"></span>
            </div>
            <form asp-controller="Home" asp-action="RequestVehicle" method="post">
                <input type="hidden" name="VehicleId" id="modalVehicleId" />
                <div class="form-row">
                    <div class="form-group">
                        <label>Start Date & Time</label>
                        <input type="datetime-local" name="StartTime" id="startTime" required onchange="updateDuration()" />
                    </div>
                    <div class="form-group">
                        <label>End Date & Time</label>
                        <input type="datetime-local" name="EndTime" id="endTime" required onchange="updateDuration()" />
                    </div>
                </div>
                <div class="duration-display" id="durationDisplay">Select start and end time to see duration</div>
                <div class="form-group">
                    <label>Purpose / Destination</label>
                    <textarea name="Purpose" rows="3" placeholder="e.g. Client visit to Chennai airport..." required></textarea>
                </div>
                <button type="submit" class="submit-btn">Submit Request →</button>
            </form>
        </div>
    </div>
</div>

@* ── Profile Modal ── *@
<div class="modal-overlay" id="profileModal">
    <div class="modal-box modal-box-wide">

        <!-- Green banner header -->
        <div class="profile-modal-header">
            <div class="profile-modal-banner">
                <h5>My Profile</h5>
                <p>View your account details and change your password</p>
                <button class="profile-modal-close" onclick="closeProfileModal()">✕</button>
            </div>
        </div>

        <!-- Avatar + name row -->
        <div class="profile-avatar-wrap">
            <div class="profile-avatar-circle">
                @Model.UserName.Substring(0, 1).ToUpper()
            </div>
            <div class="profile-avatar-info">
                <div class="profile-avatar-name">@Model.UserName</div>
                <div class="profile-avatar-emp">#@Model.EmployeeNumber</div>
            </div>
        </div>

        @{
            var pillCls = Model.Role switch
            {
                "SuperAdmin" => "pill-superadmin",
                "Admin"      => "pill-admin",
                "Driver"     => "pill-driver",
                _            => "pill-employee"
            };
        }
        <span class="profile-role-pill @pillCls">@Model.Role</span>

        <!-- Tabs -->
        <div class="profile-tabs">
            <button class="profile-tab active" onclick="switchTab('tabInfo', this)">Account Info</button>
