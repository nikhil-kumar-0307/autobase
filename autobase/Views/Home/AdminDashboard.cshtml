@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />

<div class="ab-shell">

    @await Html.PartialAsync("_AdminSidebar")

    <div class="ab-main">
        @await Html.PartialAsync("_AdminTopbar")

        <div class="ab-content">
            <div class="page-header">
                <div class="page-title">Welcome back, @ViewBag.Name 👋</div>
                <div class="page-sub">Role: <strong>@ViewBag.Role</strong> &nbsp;|&nbsp; Emp No: <strong>@ViewBag.EmpNo</strong></div>
            </div>
        </div>
    </div>

</div>
