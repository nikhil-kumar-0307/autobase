@model List<autobase.Models.Entities.Vehicle>
@{
    ViewData["Title"] = "Delete Vehicle";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<style>
    .table-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }

    .table-toolbar {
        padding: 16px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .table-toolbar-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
        flex: 1;
    }

    .search-input {
        height: 36px;
        padding: 0 14px;
        background: var(--bg);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        color: var(--text);
        outline: none;
        width: 220px;
        transition: border-color 0.15s;
    }

        .search-input:focus {
            border-color: var(--accent);
        }

        .search-input::placeholder {
            color: var(--muted2);
        }

    .ab-table {
        width: 100%;
        border-collapse: collapse;
    }

        .ab-table th {
            padding: 11px 18px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--muted);
            background: var(--bg);
            text-align: left;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .ab-table td {
            padding: 13px 18px;
            font-size: 13.5px;
            color: var(--text);
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        .ab-table tbody tr:last-child td {
            border-bottom: none;
        }

        .ab-table tbody tr:hover {
            background: #fff8f8;
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

        .status-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .pill-available {
        background: rgba(34,197,94,0.12);
        color: #16a34a;
    }

    .pill-allocated {
        background: rgba(245,197,24,0.15);
        color: #a07800;
    }

    .pill-maintenance {
        background: rgba(239,68,68,0.12);
        color: #dc2626;
    }

    .btn-disable {
        height: 32px;
        padding: 0 14px;
        background: #fff5f5;
        color: var(--danger);
        border: 1.5px solid #fecaca;
        border-radius: 7px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.15s;
    }

        .btn-disable:hover {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
        }

        .btn-disable svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: var(--muted);
    }

        .empty-state svg {
            width: 48px;
            height: 48px;
            stroke: var(--muted2);
            fill: none;
            stroke-width: 1.5;
            display: block;
            margin: 0 auto 14px;
        }

    .success-alert {
        background: #f0fff4;
        border: 1px solid #9ae6b4;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 13px;
        color: #276749;
        margin-bottom: 22px;
    }

    .error-alert {
        background: #fff5f5;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 13px;
        color: #dc2626;
        margin-bottom: 22px;
    }

    .info-box {
        background: rgba(245,197,24,0.08);
        border: 1px solid rgba(245,197,24,0.25);
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 13px;
        color: #a07800;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 22px;
    }

        .info-box svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
            margin-top: 1px;
            stroke: #a07800;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
    /* Modal */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        z-index: 999;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 32px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
        animation: popIn 0.2s ease;
    }

    @@keyframes popIn {
        from {
            transform: scale(0.92);
            opacity: 0;
        }

        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .modal-icon {
        width: 52px;
        height: 52px;
        background: #fff5f5;
        border: 2px solid #fecaca;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
    }

        .modal-icon svg {
            width: 24px;
            height: 24px;
            stroke: var(--danger);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .modal-title {
        font-size: 18px;
        font-weight: 800;
        color: var(--text);
        text-align: center;
        margin-bottom: 8px;
    }

    .modal-desc {
        font-size: 13px;
        color: var(--muted);
        text-align: center;
    }

    .modal-vehicle-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
        text-align: center;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 10px 16px;
        margin: 14px 0;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .modal-btn-cancel {
        flex: 1;
        height: 42px;
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: 9px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        transition: all 0.15s;
    }

        .modal-btn-cancel:hover {
            border-color: #ccc;
            color: var(--text);
        }

    .modal-btn-disable {
        flex: 1;
        height: 42px;
        background: var(--danger);
        border: none;
        border-radius: 9px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #fff;
        cursor: pointer;
        transition: background 0.15s;
    }

        .modal-btn-disable:hover {
            background: #c91e1e;
        }
</style>

<div class="ab-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="ab-main">
        @await Html.PartialAsync("_AdminTopbar")
        <div class="ab-content">

            <div class="page-header">
                <div class="page-title">Disable Vehicle</div>
                <div class="page-sub">Disabled vehicles are hidden from the fleet but not permanently deleted.</div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="success-alert">✅ @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="error-alert">❌ @TempData["Error"]</div>
            }

            <div class="info-box">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                Disabling a vehicle hides it from all lists. The data is <strong>not deleted</strong> from the database and can be restored later.
            </div>

            <div class="table-card">
                <div class="table-toolbar">
                    <span class="table-toolbar-title">Active Vehicles (@Model.Count)</span>
                    <input class="search-input" type="text" placeholder="🔍 Search..."
                           oninput="filterTable(this)" />
                </div>

                @if (!Model.Any())
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2" /><path d="M16 8h4l3 5v3h-7V8z" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                        <p>No active vehicles found.</p>
                    </div>
                }
                else
                {
                    <table class="ab-table" id="vehicleTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Vehicle Name</th>
                                <th>Reg. Number</th>
                                <th>Type</th>
                                <th>Year</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                <tr>
                                    <td style="color:var(--muted);font-size:12px;">@v.Id</td>
                                    <td><strong>@v.VehicleName</strong></td>
                                    <td style="font-family:monospace;font-size:13px;">@v.RegistrationNumber</td>
                                    <td>@v.VehicleType</td>
                                    <td>@v.Year</td>
                                    @* <td>@v.Quantity</td> *@
                                    <td>
                                        @{
                                            var pillClass = v.Status switch
                                            {
                                                "Available" => "pill-available",
                                                "Allocated" => "pill-allocated",
                                                "Maintenance" => "pill-maintenance",
                                                _ => "pill-available"
                                            };
                                        }
                                        <span class="status-pill @pillClass">@v.Status</span>
                                    </td>
                                    <td>
                                        <button type="button" class="btn-disable"
                                                onclick="openModal(@v.Id, '@Html.Raw(v.VehicleName)', '@v.RegistrationNumber')">
                                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" /></svg>
                                            Disable
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

        </div>
    </div>
</div>

<!-- Confirm Disable Modal -->
<div class="modal-overlay" id="deleteModal">
    <div class="modal-box">
        <div class="modal-icon">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="4.93" y1="4.93" x2="19.07" y2="19.07" /></svg>
        </div>
        <div class="modal-title">Disable Vehicle?</div>
        <div class="modal-desc">You are about to disable:</div>
        <div class="modal-vehicle-name" id="modalVehicleName">—</div>
        <div class="modal-desc" style="color:#a07800; font-weight:600;">
            The vehicle will be hidden from the fleet. Data is <u>not deleted</u>.
        </div>
        <div class="modal-actions">
            <button class="modal-btn-cancel" onclick="closeModal()">Cancel</button>
            <form id="deleteForm" method="post" style="flex:1;">
                @Html.AntiForgeryToken()
                <button type="submit" class="modal-btn-disable" style="width:100%;">
                    Yes, Disable
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id, name, regNo) {
            document.getElementById('modalVehicleName').textContent = name + '  —  ' + regNo;
            document.getElementById('deleteForm').action = '/Vehicle/ConfirmDelete/' + id;
            document.getElementById('deleteModal').classList.add('show');
        }

        function closeModal() {
            document.getElementById('deleteModal').classList.remove('show');
        }

        document.getElementById('deleteModal').addEventListener('click', function(e) {
            if (e.target === this) closeModal();
        });

        function filterTable(input) {
            const q = input.value.toLowerCase();
            document.querySelectorAll('#vehicleTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>
}
