@model List<autobase.Models.Entities.Vehicle>
@{
    ViewData["Title"] = "Edit Vehicle";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<style>
    .table-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }

    .table-toolbar {
        padding: 16px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .table-toolbar-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
        flex: 1;
    }

    .search-input {
        height: 36px;
        padding: 0 14px;
        background: var(--bg);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        color: var(--text);
        outline: none;
        width: 220px;
        transition: border-color 0.15s;
    }

        .search-input:focus {
            border-color: var(--accent);
        }

        .search-input::placeholder {
            color: var(--muted2);
        }

    .ab-table {
        width: 100%;
        border-collapse: collapse;
    }

        .ab-table th {
            padding: 11px 18px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--muted);
            background: var(--bg);
            text-align: left;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .ab-table td {
            padding: 13px 18px;
            font-size: 13.5px;
            color: var(--text);
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        .ab-table tbody tr:last-child td {
            border-bottom: none;
        }

        .ab-table tbody tr:hover {
            background: var(--bg);
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

        .status-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .pill-available {
        background: rgba(34,197,94,0.12);
        color: #16a34a;
    }

    .pill-allocated {
        background: rgba(245,197,24,0.15);
        color: #a07800;
    }

    .pill-maintenance {
        background: rgba(239,68,68,0.12);
        color: #dc2626;
    }

    .btn-edit {
        height: 32px;
        padding: 0 14px;
        background: var(--accent);
        border: none;
        border-radius: 7px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 12px;
        font-weight: 700;
        color: #111;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background 0.15s;
    }

        .btn-edit:hover {
            background: var(--accent-dark);
            color: #fff;
        }

        .btn-edit svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .btn-add-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 38px;
        padding: 0 20px;
        background: var(--accent);
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        color: #111;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-add-link:hover {
            background: var(--accent-dark);
            color: #fff;
        }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: var(--muted);
    }

        .empty-state svg {
            width: 48px;
            height: 48px;
            stroke: var(--muted2);
            fill: none;
            stroke-width: 1.5;
            display: block;
            margin: 0 auto 14px;
        }

    .success-alert {
        background: #f0fff4;
        border: 1px solid #9ae6b4;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 13px;
        color: #276749;
        margin-bottom: 22px;
    }

    .qty-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 2px 10px;
        font-size: 13px;
        font-weight: 700;
        color: var(--text);
        min-width: 36px;
    }
</style>

<div class="ab-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="ab-main">
        @await Html.PartialAsync("_AdminTopbar")
        <div class="ab-content">

            <div class="page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
                <div>
                    <div class="page-title">Edit Vehicle</div>
                    <div class="page-sub">Click Edit on any vehicle to update its details.</div>
                </div>
                <a asp-controller="Vehicle" asp-action="AddVehicle" class="btn-add-link">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Add Vehicle
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="success-alert">✅ @TempData["Success"]</div>
            }

            <div class="table-card">
                <div class="table-toolbar">
                    <span class="table-toolbar-title">All Vehicles (@Model.Count)</span>
                    <input class="search-input" type="text" placeholder="🔍 Search..."
                           oninput="filterTable(this)" />
                </div>

                @if (!Model.Any())
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2" /><path d="M16 8h4l3 5v3h-7V8z" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                        <p>No vehicles added yet.</p>
                        <a asp-controller="Vehicle" asp-action="AddVehicle" class="btn-add-link" style="margin-top:12px;">Add First Vehicle</a>
                    </div>
                }
                else
                {
                    <table class="ab-table" id="vehicleTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Vehicle Name</th>
                                <th>Reg. Number</th>
                                <th>Type</th>
                                <th>Year</th>
                                <th>Quantity</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                <tr>
                                    <td style="color:var(--muted);font-size:12px;">@v.Id</td>
                                    <td><strong>@v.VehicleName</strong></td>
                                    <td style="font-family:monospace;font-size:13px;">@v.RegistrationNumber</td>
                                    <td>@v.VehicleType</td>
                                    <td>@v.Year</td>
                                    <td><span class="qty-badge">@v.Quantity</span></td>
                                    <td>
                                        @{
                                            var pillClass = v.Status switch
                                            {
                                                "Available" => "pill-available",
                                                "Allocated" => "pill-allocated",
                                                "Maintenance" => "pill-maintenance",
                                                _ => "pill-available"
                                            };
                                        }
                                        <span class="status-pill @pillClass">@v.Status</span>
                                    </td>
                                    <td>
                                        <a asp-controller="Vehicle" asp-action="EditVehicleForm"
                                           asp-route-id="@v.Id" class="btn-edit">
                                            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable(input) {
            const q = input.value.toLowerCase();
            document.querySelectorAll('#vehicleTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>
}
