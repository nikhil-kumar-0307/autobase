@model autobase.Models.ViewModels.AddVehicleViewModel
@{
    ViewData["Title"] = "Add Vehicle";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Nunito:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<style>
    /* ════════════════════════════════════════════════════
       ROOT TOKENS
    ════════════════════════════════════════════════════ */
    .fv {
        --red: #d62839;
        --red-dk: #b01e2d;
        --red-lt: rgba(214,40,57,0.08);
        --red-glow: rgba(214,40,57,0.18);
        --blue: #1a3a6b;
        --blue-md: #2251a3;
        --blue-lt: rgba(26,58,107,0.07);
        --blue-glow: rgba(34,81,163,0.18);
        --white: #ffffff;
        --off: #f7f8fc;
        --off2: #eef0f7;
        --border: #dde2f0;
        --border2: #c8cfe6;
        --ink: #0d1329;
        --ink2: #2c3454;
        --muted: #7580a0;
        --muted2: #a8b0cc;
        --success: #17a34a;
        --warn: #d97706;
        --r: 14px;
        --r-sm: 9px;
        font-family: 'Nunito', sans-serif;
        color: var(--ink);
    }

    /* ════════════════════════════════════════════════════
       BREADCRUMB
    ════════════════════════════════════════════════════ */
    .fv-crumb {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12.5px;
        color: var(--muted);
        margin-bottom: 24px;
    }

        .fv-crumb a {
            color: var(--muted);
            text-decoration: none;
            transition: color .15s;
        }

            .fv-crumb a:hover {
                color: var(--blue-md);
            }

        .fv-crumb .sep {
            color: var(--muted2);
        }

        .fv-crumb .cur {
            color: var(--ink2);
            font-weight: 700;
        }

    /* ════════════════════════════════════════════════════
       PAGE HERO
    ════════════════════════════════════════════════════ */
    .fv-hero {
        display: flex;
        align-items: stretch;
        border-radius: var(--r);
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(26,58,107,0.13);
        margin-bottom: 28px;
        animation: heroIn .5s cubic-bezier(.22,1,.36,1) both;
    }

    @@keyframes heroIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .fv-hero-stripe {
        width: 8px;
        background: linear-gradient(180deg, var(--red) 0%, var(--red-dk) 100%);
        flex-shrink: 0;
    }

    .fv-hero-body {
        flex: 1;
        background: linear-gradient(110deg, var(--blue) 0%, var(--blue-md) 100%);
        padding: 24px 28px;
        display: flex;
        align-items: center;
        gap: 20px;
        position: relative;
        overflow: hidden;
    }

        .fv-hero-body::before,
        .fv-hero-body::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            border: 1.5px solid rgba(255,255,255,0.07);
        }

        .fv-hero-body::before {
            width: 200px;
            height: 200px;
            right: -60px;
            top: -80px;
        }

        .fv-hero-body::after {
            width: 120px;
            height: 120px;
            right: 80px;
            bottom: -50px;
        }

    .fv-hero-icon-wrap {
        width: 54px;
        height: 54px;
        border-radius: 14px;
        flex-shrink: 0;
        background: rgba(255,255,255,0.12);
        border: 1.5px solid rgba(255,255,255,0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
    }

        .fv-hero-icon-wrap svg {
            width: 26px;
            height: 26px;
            stroke: #fff;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .fv-hero-text {
        position: relative;
        z-index: 1;
    }

    .fv-hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'Rajdhani', sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.55);
        margin-bottom: 5px;
    }

    .fv-hero-tag-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--red);
    }

    .fv-hero-title {
        font-family: 'Rajdhani', sans-serif;
        font-size: 28px;
        font-weight: 700;
        line-height: 1.1;
        color: #fff;
        letter-spacing: .01em;
    }

        .fv-hero-title span {
            color: #ff8a95;
        }

    .fv-hero-sub {
        font-size: 13px;
        color: rgba(255,255,255,0.5);
        margin-top: 5px;
    }

    .fv-hero-badge {
        margin-left: auto;
        position: relative;
        z-index: 1;
        background: var(--red);
        border-radius: 8px;
        padding: 6px 16px;
        font-family: 'Rajdhani', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: #fff;
        box-shadow: 0 4px 14px rgba(214,40,57,0.45);
        white-space: nowrap;
    }

    /* ════════════════════════════════════════════════════
       BANNERS
    ════════════════════════════════════════════════════ */
    .fv-banner {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 13px 18px;
        border-radius: var(--r-sm);
        font-size: 13.5px;
        margin-bottom: 22px;
        border-left: 4px solid;
        animation: bannerSlide .4s ease both;
    }

    @@keyframes bannerSlide {
        from {
            opacity: 0;
            transform: translateX(-8px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .fv-banner.info {
        background: #edf2fb;
        border-color: var(--blue-md);
        color: var(--blue);
    }

    .fv-banner.ok {
        background: #edfaf3;
        border-color: var(--success);
        color: #14532d;
    }

    .fv-banner-ico {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .fv-banner.info .fv-banner-ico {
        background: rgba(34,81,163,0.12);
    }

    .fv-banner.ok .fv-banner-ico {
        background: rgba(23,163,74,0.14);
    }

    .fv-banner-ico svg {
        width: 15px;
        height: 15px;
        fill: none;
        stroke-width: 2.3;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .fv-banner.info .fv-banner-ico svg {
        stroke: var(--blue-md);
    }

    .fv-banner.ok .fv-banner-ico svg {
        stroke: var(--success);
    }

    /* ════════════════════════════════════════════════════
       LAYOUT
    ════════════════════════════════════════════════════ */
    .fv-layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 20px;
        align-items: start;
    }

    /* ════════════════════════════════════════════════════
       CARD
    ════════════════════════════════════════════════════ */
    .fv-card {
        background: var(--white);
        border: 1.5px solid var(--border);
        border-radius: var(--r);
        box-shadow: 0 2px 16px rgba(26,58,107,0.07);
        overflow: hidden;
        animation: cardUp .5s cubic-bezier(.22,1,.36,1) .08s both;
    }

    @@keyframes cardUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .fv-card-accent {
        height: 4px;
        background: linear-gradient(90deg, var(--red) 0%, var(--blue-md) 100%);
    }

    .fv-card-head {
        padding: 18px 26px;
        border-bottom: 1.5px solid var(--border);
        display: flex;
        align-items: center;
        gap: 12px;
        background: var(--off);
    }

    .fv-card-head-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        flex-shrink: 0;
        background: var(--blue-lt);
        border: 1.5px solid rgba(34,81,163,0.18);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .fv-card-head-icon svg {
            width: 16px;
            height: 16px;
            stroke: var(--blue-md);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .fv-card-head-title {
        font-family: 'Rajdhani', sans-serif;
        font-size: 15px;
        font-weight: 700;
        color: var(--ink2);
        letter-spacing: .01em;
    }

    .fv-card-head-sub {
        font-size: 12px;
        color: var(--muted);
        margin-top: 1px;
    }

    .fv-card-head-count {
        margin-left: auto;
        font-family: 'Rajdhani', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--blue-md);
        background: var(--blue-lt);
        border: 1px solid rgba(34,81,163,0.18);
        border-radius: 6px;
        padding: 3px 10px;
    }

    .fv-card-body {
        padding: 28px 26px;
    }

    /* ════════════════════════════════════════════════════
       SECTION HEADER
    ════════════════════════════════════════════════════ */
    .fv-sec-hd {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .fv-sec-pip {
        width: 4px;
        height: 20px;
        border-radius: 99px;
        flex-shrink: 0;
        background: linear-gradient(180deg, var(--red), var(--blue-md));
    }

    .fv-sec-label {
        font-family: 'Rajdhani', sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
        color: var(--ink2);
    }

    .fv-sec-line {
        flex: 1;
        height: 1px;
        background: var(--border);
    }

    /* ════════════════════════════════════════════════════
       FORM GRID & GROUP
    ════════════════════════════════════════════════════ */
    .fv-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

        .fv-grid .fw {
            grid-column: 1 / -1;
        }

    .fv-fg {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .fv-lbl {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink2);
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .fv-lbl .req {
            color: var(--red);
            font-size: 16px;
            line-height: 1;
        }

        .fv-lbl .opt {
            margin-left: auto;
            font-size: 11px;
            font-weight: 500;
            color: var(--muted2);
            text-transform: none;
            letter-spacing: 0;
        }

    .fv-err {
        font-size: 12px;
        color: var(--red);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* ════════════════════════════════════════════════════
       INPUT SHELL
    ════════════════════════════════════════════════════ */
    .fv-input-shell {
        position: relative;
        display: flex;
        align-items: center;
    }

    .fv-shell-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        width: 16px;
        height: 16px;
        stroke: var(--muted2);
        fill: none;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
        pointer-events: none;
        transition: stroke .15s;
        z-index: 1;
    }

    .fv-input-shell:focus-within .fv-shell-icon {
        stroke: var(--blue-md);
    }

    .fv-shell-chevron {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        width: 14px;
        height: 14px;
        pointer-events: none;
        stroke: var(--muted2);
        fill: none;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: stroke .15s;
    }

    .fv-input-shell:focus-within .fv-shell-chevron {
        stroke: var(--blue-md);
    }

    .fv-ctrl {
        width: 100%;
        height: 46px;
        padding: 0 14px 0 40px;
        background: var(--off);
        border: 1.5px solid var(--border2);
        border-radius: var(--r-sm);
        font-family: 'Nunito', sans-serif;
        font-size: 14px;
        font-weight: 500;
        color: var(--ink);
        outline: none;
        transition: border-color .2s, background .2s, box-shadow .2s;
    }

        .fv-ctrl::placeholder {
            color: var(--muted2);
            font-size: 13px;
        }

        .fv-ctrl:focus {
            border-color: var(--blue-md);
            background: var(--white);
            box-shadow: 0 0 0 3px var(--blue-glow);
        }

    select.fv-ctrl {
        appearance: none;
        cursor: pointer;
    }

    textarea.fv-ctrl {
        height: auto;
        padding: 12px 14px;
        resize: vertical;
        line-height: 1.6;
    }

    .fv-ctrl.bare {
        padding-left: 14px;
    }

    .fv-status-dot {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        width: 9px;
        height: 9px;
        border-radius: 50%;
        pointer-events: none;
        z-index: 2;
        transition: background .2s;
    }

    /* ════════════════════════════════════════════════════
       DIVIDER
    ════════════════════════════════════════════════════ */
    .fv-div {
        height: 1px;
        background: var(--border);
        margin: 26px 0;
    }

    /* ════════════════════════════════════════════════════
       ACTIONS
    ════════════════════════════════════════════════════ */
    .fv-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .fv-btn-save {
        height: 48px;
        padding: 0 28px;
        background: linear-gradient(135deg, var(--red) 0%, var(--red-dk) 100%);
        border: none;
        border-radius: var(--r-sm);
        font-family: 'Rajdhani', sans-serif;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 9px;
        transition: all .18s;
        box-shadow: 0 4px 14px rgba(214,40,57,0.3);
        position: relative;
        overflow: hidden;
    }

        .fv-btn-save::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(255,255,255,0) 40%, rgba(255,255,255,0.15));
            opacity: 0;
            transition: opacity .2s;
        }

        .fv-btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(214,40,57,0.4);
        }

            .fv-btn-save:hover::after {
                opacity: 1;
            }

        .fv-btn-save:active {
            transform: scale(.97);
        }

        .fv-btn-save svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .fv-btn-cancel {
        height: 48px;
        padding: 0 22px;
        background: var(--white);
        border: 1.5px solid var(--border2);
        border-radius: var(--r-sm);
        font-family: 'Nunito', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
        text-decoration: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all .15s;
    }

        .fv-btn-cancel:hover {
            border-color: var(--blue-md);
            color: var(--blue);
            background: var(--blue-lt);
        }

        .fv-btn-cancel svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .fv-actions-note {
        margin-left: auto;
        font-size: 12px;
        color: var(--muted2);
    }

    .fv-val-sum {
        background: #fff5f6;
        border: 1.5px solid rgba(214,40,57,.25);
        border-left: 4px solid var(--red);
        border-radius: var(--r-sm);
        padding: 13px 16px;
        font-size: 13px;
        color: var(--red);
        margin-bottom: 20px;
    }

    /* ════════════════════════════════════════════════════
       SIDE PANEL
    ════════════════════════════════════════════════════ */
    .fv-side {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .fv-stat-card {
        background: var(--white);
        border: 1.5px solid var(--border);
        border-radius: var(--r);
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(26,58,107,0.07);
        animation: cardUp .5s cubic-bezier(.22,1,.36,1) .15s both;
    }

    .fv-stat-card-accent {
        height: 4px;
        background: linear-gradient(90deg, var(--blue-md), var(--red));
    }

    .fv-stat-card-hd {
        padding: 14px 18px;
        border-bottom: 1px solid var(--border);
        background: var(--off);
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .fv-stat-card-hd svg {
            width: 14px;
            height: 14px;
            stroke: var(--blue-md);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .fv-stat-card-hd span {
            font-family: 'Rajdhani', sans-serif;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
            color: var(--ink2);
        }

    .fv-stat-card-body {
        padding: 18px;
    }

    .fv-status-list {
        display: flex;
        flex-direction: column;
        gap: 11px;
    }

    .fv-status-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 13px;
        border-radius: 8px;
        border: 1.5px solid var(--border);
        background: var(--off);
        transition: all .15s;
        cursor: default;
    }

        .fv-status-item:hover {
            border-color: var(--border2);
            background: var(--off2);
        }

        .fv-status-item.active-status {
            border-color: rgba(34,81,163,0.25);
            background: var(--blue-lt);
        }

    .fv-si-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .fv-si-label {
        font-size: 13px;
        font-weight: 700;
        color: var(--ink2);
    }

    .fv-si-desc {
        font-size: 11.5px;
        color: var(--muted);
        margin-top: 1px;
    }

    .fv-steps-card {
        background: linear-gradient(145deg, var(--blue) 0%, var(--blue-md) 100%);
        border-radius: var(--r);
        padding: 20px;
        box-shadow: 0 6px 22px rgba(26,58,107,0.22);
        animation: cardUp .5s cubic-bezier(.22,1,.36,1) .22s both;
        position: relative;
        overflow: hidden;
    }

        .fv-steps-card::before {
            content: '';
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 1.5px solid rgba(255,255,255,.07);
            bottom: -50px;
            right: -30px;
        }

    .fv-steps-title {
        font-family: 'Rajdhani', sans-serif;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: rgba(255,255,255,.6);
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

        .fv-steps-title::before {
            content: '';
            display: inline-block;
            width: 16px;
            height: 2px;
            background: var(--red);
            border-radius: 99px;
        }

    .fv-step {
        display: flex;
        gap: 12px;
        align-items: flex-start;
        margin-bottom: 14px;
    }

        .fv-step:last-child {
            margin-bottom: 0;
        }

    .fv-step-num {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        flex-shrink: 0;
        background: var(--red);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Rajdhani', sans-serif;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
        box-shadow: 0 2px 8px rgba(214,40,57,0.4);
        margin-top: 1px;
    }

    .fv-step-title {
        font-size: 13px;
        font-weight: 700;
        color: #fff;
    }

    .fv-step-desc {
        font-size: 12px;
        color: rgba(255,255,255,.5);
        margin-top: 2px;
        line-height: 1.5;
    }

    /* ════════════════════════════════════════════════════
       RESPONSIVE
    ════════════════════════════════════════════════════ */
    @@media (max-width: 960px) {
        .fv-layout {
            grid-template-columns: 1fr;
        }

        .fv-side {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .fv-stat-card, .fv-steps-card {
            flex: 1;
            min-width: 240px;
        }
    }

    @@media (max-width: 640px) {
        .fv-grid {
            grid-template-columns: 1fr;
        }

            .fv-grid .fw {
                grid-column: 1;
            }

        .fv-card-body {
            padding: 20px 16px;
        }

        .fv-card-head {
            padding: 14px 16px;
        }

        .fv-hero-badge {
            display: none;
        }

        .fv-hero-body {
            padding: 18px 20px;
        }

        .fv-hero-title {
            font-size: 22px;
        }

        .fv-actions {
            flex-direction: column;
        }

        .fv-btn-save, .fv-btn-cancel {
            width: 100%;
            justify-content: center;
        }

        .fv-actions-note {
            display: none;
        }
    }
</style>

<div class="ab-shell fv">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="ab-main">
        @await Html.PartialAsync("_AdminTopbar")
        <div class="ab-content">

            <!-- Breadcrumb -->
            <nav class="fv-crumb">
                <a href="#">Dashboard</a>
                <span class="sep">›</span>
                <a href="#">Fleet</a>
                <span class="sep">›</span>
                <span class="cur">Add Vehicle</span>
            </nav>

            <!-- Hero -->
            <div class="fv-hero">
                <div class="fv-hero-stripe"></div>
                <div class="fv-hero-body">
                    <div class="fv-hero-icon-wrap">
                        <svg viewBox="0 0 24 24">
                            <rect x="1" y="3" width="15" height="13" rx="2" />
                            <path d="M16 8h4l3 5v3h-7V8z" />
                            <circle cx="5.5" cy="18.5" r="2.5" />
                            <circle cx="18.5" cy="18.5" r="2.5" />
                        </svg>
                    </div>
                    <div class="fv-hero-text">
                        <div class="fv-hero-tag">
                            <span class="fv-hero-tag-dot"></span>
                            Fleet Management
                        </div>
                        <div class="fv-hero-title">Register <span>New Vehicle</span></div>
                        <div class="fv-hero-sub">Add a new unit to the Autobase fleet inventory</div>
                    </div>
                    <div class="fv-hero-badge">New Entry</div>
                </div>
            </div>

            <!-- Success Banner -->
            @if (TempData["Success"] != null)
            {
                <div class="fv-banner ok">
                    <div class="fv-banner-ico">
                        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                    </div>
                    <div><strong>Success!</strong> &nbsp;@TempData["Success"]</div>
                </div>
            }

            <!-- Info Banner -->
            <div class="fv-banner info">
                <div class="fv-banner-ico">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                </div>
                <span>Fields marked <strong>*</strong> are required. Vehicle Name &amp; Type are sourced from your registered vehicle catalogue.</span>
            </div>

            <!-- Two-column layout -->
            <div class="fv-layout">

                <!-- ══ MAIN FORM CARD ══ -->
                <div class="fv-card">
                    <div class="fv-card-accent"></div>
                    <div class="fv-card-head">
                        <div class="fv-card-head-icon">
                            <svg viewBox="0 0 24 24">
                                <rect x="1" y="3" width="15" height="13" rx="2" />
                                <path d="M16 8h4l3 5v3h-7V8z" />
                                <circle cx="5.5" cy="18.5" r="2.5" />
                                <circle cx="18.5" cy="18.5" r="2.5" />
                            </svg>
                        </div>
                        <div>
                            <div class="fv-card-head-title">Vehicle Details</div>
                            <div class="fv-card-head-sub">Fill in all fields to complete registration</div>
                        </div>
                        <div class="fv-card-head-count">Form</div>
                    </div>

                    <div class="fv-card-body">
                        <form asp-controller="Vehicle" asp-action="AddVehicle" method="post">

                            @if (ViewData.ModelState.ErrorCount > 0)
                            {
                                <div class="fv-val-sum">
                                    <div asp-validation-summary="All"></div>
                                </div>
                            }

                            <!-- ── Basic Info ── -->
                            <div class="fv-sec-hd">
                                <div class="fv-sec-pip"></div>
                                <span class="fv-sec-label">Basic Information</span>
                                <div class="fv-sec-line"></div>
                            </div>

                            <div class="fv-grid">

                                <!-- Vehicle Name dropdown -->
                                <div class="fv-fg">
                                    <label asp-for="VehicleName" class="fv-lbl">
                                        Vehicle Name <span class="req">*</span>
                                    </label>
                                    <div class="fv-input-shell">
                                        <svg class="fv-shell-icon" viewBox="0 0 24 24">
                                            <rect x="1" y="3" width="15" height="13" rx="2" />
                                            <path d="M16 8h4l3 5v3h-7V8z" />
                                            <circle cx="5.5" cy="18.5" r="2.5" />
                                            <circle cx="18.5" cy="18.5" r="2.5" />
                                        </svg>
                                        <select asp-for="VehicleName" class="fv-ctrl" id="vehicleNameSel"
                                                onchange="syncType(this)">
                                            <option value="">— Choose vehicle —</option>
                                            @if (ViewBag.VehicleTypeList != null)
                                            {
                                                var names = ((IEnumerable<autobase.Models.Entities.VehicleType>)ViewBag.VehicleTypeList)
                                                .Select(v => v.VehicleName).Distinct().OrderBy(n => n);
                                                foreach (var name in names)
                                                {
                                                    <option value="@name">@name</option>
                                                }
                                            }
                                        </select>
                                        <svg class="fv-shell-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                                    </div>
                                    <span asp-validation-for="VehicleName" class="fv-err"></span>
                                </div>

                                <!-- Vehicle Type dropdown (filtered) -->
                                <div class="fv-fg">
                                    <label asp-for="VehicleType" class="fv-lbl">
                                        Vehicle Type <span class="req">*</span>
                                    </label>
                                    <div class="fv-input-shell">
                                        <svg class="fv-shell-icon" viewBox="0 0 24 24">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                            <polyline points="14 2 14 8 20 8" />
                                        </svg>
                                        <select asp-for="VehicleType" class="fv-ctrl" id="vehicleTypeSel">
                                            <option value="">— Pick name first —</option>
                                        </select>
                                        <svg class="fv-shell-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                                    </div>
                                    <span asp-validation-for="VehicleType" class="fv-err"></span>
                                </div>

                                <!-- Registration Number -->
                                <div class="fv-fg">
                                    <label asp-for="RegistrationNumber" class="fv-lbl">
                                        Registration No. <span class="req">*</span>
                                    </label>
                                    <div class="fv-input-shell">
                                        <svg class="fv-shell-icon" viewBox="0 0 24 24">
                                            <rect x="2" y="5" width="20" height="14" rx="2" />
                                            <line x1="2" y1="10" x2="22" y2="10" />
                                        </svg>
                                        <input asp-for="RegistrationNumber" class="fv-ctrl" placeholder="e.g. MH12AB1234" />
                                    </div>
                                    <span asp-validation-for="RegistrationNumber" class="fv-err"></span>
                                </div>

                                <!-- Year -->
                                <div class="fv-fg">
                                    <label asp-for="Year" class="fv-lbl">
                                        Year of Manufacture <span class="req">*</span>
                                        <span class="opt">1990–2030</span>
                                    </label>
                                    <div class="fv-input-shell">
                                        <svg class="fv-shell-icon" viewBox="0 0 24 24">
                                            <rect x="3" y="4" width="18" height="18" rx="2" />
                                            <line x1="16" y1="2" x2="16" y2="6" />
                                            <line x1="8" y1="2" x2="8" y2="6" />
                                            <line x1="3" y1="10" x2="21" y2="10" />
                                        </svg>
                                        <input asp-for="Year" type="number" class="fv-ctrl"
                                               placeholder="e.g. 2022" min="1990" max="2030" />
                                    </div>
                                    <span asp-validation-for="Year" class="fv-err"></span>
                                </div>

                            </div>

                            <div class="fv-div"></div>

                            <!-- ── Fleet Config ── -->
                            <div class="fv-sec-hd">
                                <div class="fv-sec-pip"></div>
                                <span class="fv-sec-label">Fleet Configuration</span>
                                <div class="fv-sec-line"></div>
                            </div>

                            <div class="fv-grid">

                                <!-- Status -->
                                <div class="fv-fg">
                                    <label asp-for="Status" class="fv-lbl">
                                        Status <span class="req">*</span>
                                    </label>
                                    <div class="fv-input-shell">
                                        <span class="fv-status-dot" id="statusDot" style="background:#17a34a;"></span>
                                        <select asp-for="Status" class="fv-ctrl" id="statusSel"
                                                style="padding-left:30px;"
                                                onchange="paintDot(this)">
                                            <option value="Available">Available</option>
                                            <option value="Allocated">Allocated</option>
                                            <option value="Maintenance">Maintenance</option>
                                        </select>
                                        <svg class="fv-shell-chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9" /></svg>
                                    </div>
                                    <span asp-validation-for="Status" class="fv-err"></span>
                                </div>

                                <!-- Notes -->
                                <div class="fv-fg fw">
                                    <label asp-for="Notes" class="fv-lbl">
                                        Notes / Remarks <span class="opt">Optional</span>
                                    </label>
                                    <div class="fv-input-shell">
                                        <textarea asp-for="Notes" class="fv-ctrl bare" rows="3"
                                                  placeholder="Insurance details, driver notes, service reminders…"></textarea>
                                    </div>
                                </div>

                            </div>

                            <div class="fv-div"></div>

                            <!-- Actions -->
                            <div class="fv-actions">
                                <button type="submit" class="fv-btn-save">
                                    <svg viewBox="0 0 24 24">
                                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
                                        <polyline points="17 21 17 13 7 13 7 21" />
                                        <polyline points="7 3 7 8 15 8" />
                                    </svg>
                                    Save Vehicle
                                </button>
                                <a asp-controller="Home" asp-action="AdminDashboard" class="fv-btn-cancel">
                                    <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg>
                                    Cancel
                                </a>
                                <span class="fv-actions-note">Saved instantly to the fleet database.</span>
                            </div>

                        </form>
                    </div>
                </div>

                <!-- ══ SIDE PANEL ══ -->
                <div class="fv-side">

                    <!-- Status guide -->
                    <div class="fv-stat-card">
                        <div class="fv-stat-card-accent"></div>
                        <div class="fv-stat-card-hd">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                            <span>Status Guide</span>
                        </div>
                        <div class="fv-stat-card-body">
                            <div class="fv-status-list">
                                <div class="fv-status-item active-status" id="dotAvail">
                                    <span class="fv-si-dot" style="background:#17a34a;"></span>
                                    <div>
                                        <div class="fv-si-label">Available</div>
                                        <div class="fv-si-desc">Ready to assign to a trip</div>
                                    </div>
                                </div>
                                <div class="fv-status-item" id="dotAlloc">
                                    <span class="fv-si-dot" style="background:#d97706;"></span>
                                    <div>
                                        <div class="fv-si-label">Allocated</div>
                                        <div class="fv-si-desc">Currently on an active trip</div>
                                    </div>
                                </div>
                                <div class="fv-status-item" id="dotMaint">
                                    <span class="fv-si-dot" style="background:#d62839;"></span>
                                    <div>
                                        <div class="fv-si-label">Maintenance</div>
                                        <div class="fv-si-desc">Under repair, not road-ready</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Steps guide -->
                    <div class="fv-steps-card">
                        <div class="fv-steps-title">Quick Guide</div>
                        <div class="fv-step">
                            <div class="fv-step-num">1</div>
                            <div>
                                <div class="fv-step-title">Pick Vehicle Name</div>
                                <div class="fv-step-desc">Select from the pre-registered catalogue. Type auto-fills.</div>
                            </div>
                        </div>
                        <div class="fv-step">
                            <div class="fv-step-num">2</div>
                            <div>
                                <div class="fv-step-title">Unique Plate Number</div>
                                <div class="fv-step-desc">Must be unique — duplicates are rejected on submit.</div>
                            </div>
                        </div>
                        <div class="fv-step">
                            <div class="fv-step-num">3</div>
                            <div>
                                <div class="fv-step-title">Set Status</div>
                                <div class="fv-step-desc">New vehicles are typically Available unless under repair.</div>
                            </div>
                        </div>
                        <div class="fv-step">
                            <div class="fv-step-num">4</div>
                            <div>
                                <div class="fv-step-title">Add Remarks</div>
                                <div class="fv-step-desc">Optional notes for insurance, history, or instructions.</div>
                            </div>
                        </div>
                    </div>

                </div><!-- /.fv-side -->

            </div><!-- /.fv-layout -->

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // ── name → types map from server ──────────────────────
        const typeMap = {};
        @if (ViewBag.VehicleTypeList != null)
        {
                foreach (var vt in (IEnumerable<autobase.Models.Entities.VehicleType>)ViewBag.VehicleTypeList)
                {
                        @:if (!typeMap["@Html.Raw(vt.VehicleName.Replace("\"", "\\\""))"]) typeMap["@Html.Raw(vt.VehicleName.Replace("\"", "\\\""))"] = [];
                        @:typeMap["@Html.Raw(vt.VehicleName.Replace("\"", "\\\""))"].push("@Html.Raw(vt.Type.Replace("\"", "\\\""))");
                }
        }

        const preName = "@Html.Raw(Model?.VehicleName ?? "")";
        const preType = "@Html.Raw(Model?.VehicleType ?? "")";

        function syncType(nameSel) {
            const typeSel = document.getElementById('vehicleTypeSel');
            const name = nameSel.value;
            typeSel.innerHTML = '';
            if (!name) {
                typeSel.innerHTML = '<option value="">— Pick name first —</option>';
                return;
            }
            const types = typeMap[name] || [];
            if (!types.length) {
                typeSel.innerHTML = '<option value="">No types for this vehicle</option>';
                return;
            }
            typeSel.innerHTML = '<option value="">— Select type —</option>';
            types.forEach(t => {
                const o = document.createElement('option');
                o.value = t; o.textContent = t;
                if (t === preType) o.selected = true;
                typeSel.appendChild(o);
            });
        }

        // ── Status dot + guide highlight ──────────────────────
        const dotColors = { Available:'#17a34a', Allocated:'#d97706', Maintenance:'#d62839' };
        const guideIds  = { Available:'dotAvail', Allocated:'dotAlloc', Maintenance:'dotMaint' };

        function paintDot(sel) {
            document.getElementById('statusDot').style.background = dotColors[sel.value] || '#7580a0';
            Object.values(guideIds).forEach(id => document.getElementById(id).classList.remove('active-status'));
            if (guideIds[sel.value]) document.getElementById(guideIds[sel.value]).classList.add('active-status');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const ss = document.getElementById('statusSel');
            if (ss) paintDot(ss);
            const ns = document.getElementById('vehicleNameSel');
            if (ns && preName) { ns.value = preName; syncType(ns); }
        });
    </script>
}
