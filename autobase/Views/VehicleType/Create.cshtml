@model autobase.Models.ViewModels.CreateVehicleViewModel
@{
    ViewData["Title"] = "Add Vehicle";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<style>
    .form-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 16px;
    }

    .form-card-header {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border);
        background: var(--bg);
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .form-card-header svg {
            width: 16px;
            height: 16px;
            stroke: var(--accent-dark);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .form-card-header span {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
        }

    .form-card-body {
        padding: 28px;
    }

    .form-card-footer {
        padding: 18px 24px;
        border-top: 1px solid var(--border);
        background: var(--bg);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px 24px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .form-label {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .req {
        width: 5px;
        height: 5px;
        background: var(--danger);
        border-radius: 50%;
        display: inline-block;
        margin-bottom: 1px;
    }

    .form-control {
        height: 44px;
        padding: 0 14px;
        background: #fff;
        border: 1.5px solid #dde1ea;
        border-radius: 10px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        color: var(--text);
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
        width: 100%;
    }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(245,197,24,0.15);
        }

        .form-control::placeholder {
            color: #c0c6d4;
        }

    .field-error {
        font-size: 12px;
        color: var(--danger);
    }
    /* Suggestion chips */
    .type-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 10px;
    }

    .chip {
        padding: 5px 12px;
        border: 1.5px solid #dde1ea;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        transition: all 0.15s;
        background: var(--bg);
        user-select: none;
    }

        .chip:hover {
            border-color: var(--accent);
            color: var(--accent-dark);
            background: rgba(245,197,24,0.08);
        }

        .chip.selected {
            border-color: var(--accent);
            background: rgba(245,197,24,0.12);
            color: var(--accent-dark);
        }
    /* Buttons */
    .btn-save {
        height: 42px;
        padding: 0 28px;
        background: var(--accent);
        border: none;
        border-radius: 9px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #111;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-save:hover {
            background: var(--accent-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(245,197,24,0.35);
        }

        .btn-save svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .btn-cancel {
        height: 42px;
        padding: 0 22px;
        background: #fff;
        border: 1.5px solid #dde1ea;
        border-radius: 9px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        transition: all 0.15s;
        text-decoration: none;
        display: flex;
        align-items: center;
    }

        .btn-cancel:hover {
            border-color: #aaa;
            color: var(--text);
        }

    .success-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f0fff4;
        border: 1px solid #9ae6b4;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 13px;
        color: #276749;
        margin-bottom: 20px;
    }

        .success-alert svg {
            width: 15px;
            height: 15px;
            flex-shrink: 0;
            stroke: #276749;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .error-alert {
        background: #fff5f5;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 13px;
        color: #dc2626;
        margin-bottom: 20px;
    }

    .hint {
        font-size: 12px;
        color: var(--muted);
        margin-top: 4px;
    }

    @@media (max-width: 640px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ab-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="ab-main">
        @await Html.PartialAsync("_AdminTopbar")
        <div class="ab-content">

            <div class="page-header">
                <div class="page-title">Add Vehicle</div>
                <div class="page-sub">Register a new vehicle name and type into the system.</div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="success-alert">
                    <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="error-alert">❌ @TempData["Error"]</div>
            }

            <form asp-controller="VehicleType" asp-action="Create" method="post">

                <div class="form-card">
                    <div class="form-card-header">
                        <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" rx="2" /><path d="M16 8h4l3 5v3h-7V8z" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
                        <span>Vehicle Information</span>
                    </div>

                    <div class="form-card-body">
                        <div class="form-grid">

                            <!-- Vehicle Name -->
                            <div class="form-group">
                                <label asp-for="VehicleName" class="form-label">
                                    Vehicle Name <span class="req"></span>
                                </label>
                                <input asp-for="VehicleName" class="form-control"
                                       placeholder="e.g. Toyota Fortuner" />
                                <span asp-validation-for="VehicleName" class="field-error"></span>
                                <span class="hint">Enter the full name of the vehicle.</span>
                            </div>

                            <!-- Vehicle Type -->
                            <div class="form-group">
                                <label asp-for="VehicleType" class="form-label">
                                    Vehicle Type <span class="req"></span>
                                </label>
                                <input asp-for="VehicleType" id="vehicleTypeInput"
                                       class="form-control"
                                       placeholder="e.g. SUV, Bus, Mini Truck..." />
                                <span asp-validation-for="VehicleType" class="field-error"></span>
                                <!-- Quick select chips -->
                                <div class="type-chips">
                                    <span class="chip" onclick="setType('SUV')">SUV</span>
                                    <span class="chip" onclick="setType('Sedan')">Sedan</span>
                                    <span class="chip" onclick="setType('Hatchback')">Hatchback</span>
                                    <span class="chip" onclick="setType('Bus')">Bus</span>
                                    <span class="chip" onclick="setType('Mini Truck')">Mini Truck</span>
                                    <span class="chip" onclick="setType('Van')">Van</span>
                                    <span class="chip" onclick="setType('Pickup')">Pickup</span>
                                    <span class="chip" onclick="setType('Bike')">Bike</span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="form-card-footer">
                        <button type="submit" class="btn-save">
                            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                            Save Vehicle
                        </button>
                        <a asp-controller="VehicleType" asp-action="EditVehicle" class="btn-cancel">
                            Cancel
                        </a>
                    </div>
                </div>

            </form>

            @if (ViewBag.Vehicles != null && ViewBag.Vehicles.Count > 0)
            {
                <div class="form-card">
                    <div class="form-card-header">
                        <svg viewBox="0 0 24 24">
                            <path d="M9 17H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3" />
                            <path d="M13 21l9-9-3-3-9 9v3h3z" />
                        </svg>
                        <span>Registered Vehicles</span>
                    </div>
                    <div class="form-card-body" style="padding: 0;">
                        <table style="width:100%; border-collapse:collapse; font-size:13.5px;">
                            <thead>
                                <tr style="background:var(--bg); border-bottom:1.5px solid var(--border);">
                                    <th style="padding:12px 20px; text-align:left; font-size:11px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; color:var(--muted);">#</th>
                                    <th style="padding:12px 20px; text-align:left; font-size:11px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; color:var(--muted);">Vehicle Name</th>
                                    <th style="padding:12px 20px; text-align:left; font-size:11px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; color:var(--muted);">Type</th>
                                    <th style="padding:12px 20px; text-align:left; font-size:11px; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; color:var(--muted);">Added On</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int rowNum = 1;
                                }
                                @foreach (var v in ViewBag.Vehicles)
                                {
                                    <tr style="border-bottom:1px solid var(--border); transition:background 0.12s;"
                                        onmouseover="this.style.background='rgba(245,197,24,0.05)'"
                                        onmouseout="this.style.background=''">
                                        <td style="padding:13px 20px; color:var(--muted);">@rowNum</td>
                                        <td style="padding:13px 20px; font-weight:600; color:var(--text);">@v.VehicleName</td>
                                        <td style="padding:13px 20px;">
                                            <span style="padding:3px 12px; background:rgba(245,197,24,0.12); color:var(--accent-dark); border-radius:20px; font-size:12px; font-weight:600; border:1px solid rgba(245,197,24,0.3);">
                                                @v.Type
                                            </span>
                                        </td>
                                        <td style="padding:13px 20px; color:var(--muted);">@v.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    </tr>
                                    rowNum++;
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="form-card-footer" style="justify-content:space-between;">
                        <span style="font-size:12px; color:var(--muted);">
                            Total: <strong style="color:var(--text);">@ViewBag.Vehicles.Count</strong> vehicle(s) registered
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="form-card">
                    <div class="form-card-body" style="text-align:center; padding:40px; color:var(--muted); font-size:13.5px;">
                        <svg viewBox="0 0 24 24" style="width:36px;height:36px;stroke:var(--muted);fill:none;stroke-width:1.5;margin-bottom:10px;">
                            <rect x="1" y="3" width="15" height="13" rx="2" />
                            <path d="M16 8h4l3 5v3h-7V8z" />
                            <circle cx="5.5" cy="18.5" r="2.5" />
                            <circle cx="18.5" cy="18.5" r="2.5" />
                        </svg>
                        <p style="margin:0;">No vehicles registered yet. Add one above.</p>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function setType(value) {
            const input = document.getElementById('vehicleTypeInput');
            input.value = value;
            // Highlight selected chip
            document.querySelectorAll('.chip').forEach(c => {
                c.classList.toggle('selected', c.textContent === value);
            });
        }

        // Highlight chip if input matches on load
        document.getElementById('vehicleTypeInput').addEventListener('input', function () {
            const val = this.value.trim();
            document.querySelectorAll('.chip').forEach(c => {
                c.classList.toggle('selected', c.textContent === val);
            });
        });
    </script>
}
