@model autobase.Models.ViewModels.SeeRequestViewModel
@{
    ViewData["Title"] = "See Requests";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

<style>
    :root {
        --green: #16a37a;
        --green-light: #edfaf4;
        --green-mid: #a7e8d2;
        --blue: #2563a8;
        --blue-light: #eff6ff;
        --amber: #c47d10;
        --amber-light: #fff8ec;
        --amber-mid: #fcd97a;
        --red: #b83535;
        --red-light: #fff1f1;
        --red-mid: #f5bfbf;
        --gray-bg: #f7f6f2;
        --border: #ebebeb;
        --border-dark: #d8d6d0;
        --text: #1e1e1c;
        --text-2: #5a5956;
        --text-3: #9a9894;
        --white: #ffffff;
        --radius-sm: 8px;
        --radius: 12px;
        --radius-lg: 16px;
        --shadow-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
        --shadow: 0 4px 12px rgba(0,0,0,.07), 0 1px 3px rgba(0,0,0,.04);
        --font: 'DM Sans', sans-serif;
        --font-mono: 'DM Mono', monospace;
    }

    * {
        font-family: var(--font);
        box-sizing: border-box;
    }

    /* ── Page header ── */
    .sr-page-header {
        margin-bottom: 28px;
    }

        .sr-page-header h1 {
            font-size: 22px;
            font-weight: 700;
            color: var(--text);
            margin: 0 0 4px;
            letter-spacing: -.3px;
        }

        .sr-page-header p {
            font-size: 13.5px;
            color: var(--text-3);
            margin: 0;
        }

    /* ── Flash ── */
    .flash {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 16px;
        border-radius: var(--radius);
        font-size: 13.5px;
        font-weight: 500;
        margin-bottom: 20px;
        border: 1px solid transparent;
    }

    .flash-ok {
        background: var(--green-light);
        color: #0e7a5c;
        border-color: var(--green-mid);
    }

    .flash-err {
        background: var(--red-light);
        color: var(--red);
        border-color: var(--red-mid);
    }

    /* ── Summary cards ── */
    .sr-stats {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
        margin-bottom: 24px;
    }
    @@media (max-width: 900px) {
        .sr-stats

    {
        grid-template-columns: repeat(3, 1fr);
    }

    }

    .stat-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 18px 20px;
        position: relative;
        overflow: hidden;
        transition: box-shadow .15s;
        cursor: pointer;
    }

        .stat-card:hover {
            box-shadow: var(--shadow);
        }

        .stat-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 3px;
            border-radius: 0 0 var(--radius) var(--radius);
        }

    .stat-total::after {
        background: var(--border-dark);
    }

    .stat-pending::after {
        background: var(--amber);
    }

    .stat-approved::after {
        background: var(--green);
    }

    .stat-rejected::after {
        background: var(--red);
    }

    .stat-completed::after {
        background: var(--blue);
    }

    .stat-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-bottom: 10px;
    }

    .stat-value {
        font-size: 36px;
        font-weight: 700;
        line-height: 1;
        color: var(--text);
        letter-spacing: -1px;
    }

    .stat-total .stat-value {
        color: var(--text);
    }

    .stat-pending .stat-value {
        color: var(--amber);
    }

    .stat-approved .stat-value {
        color: var(--green);
    }

    .stat-rejected .stat-value {
        color: var(--red);
    }

    .stat-completed .stat-value {
        color: var(--blue);
    }

    /* ── Toolbar ── */
    .sr-toolbar {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .sr-search-wrap {
        flex: 1;
        min-width: 240px;
        position: relative;
    }

    .sr-search-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-3);
        font-size: 14px;
        pointer-events: none;
    }

    .sr-search {
        width: 100%;
        padding: 10px 14px 10px 38px;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 13.5px;
        color: var(--text);
        background: var(--white);
        outline: none;
        transition: border-color .15s, box-shadow .15s;
        font-family: var(--font);
    }

        .sr-search:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 3px rgba(37,99,168,.08);
        }

        .sr-search::placeholder {
            color: var(--text-3);
        }

    .filter-pills {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .fp {
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 12.5px;
        font-weight: 600;
        border: 1.5px solid var(--border);
        background: var(--white);
        color: var(--text-2);
        cursor: pointer;
        transition: all .15s;
        white-space: nowrap;
    }

        .fp:hover {
            border-color: var(--border-dark);
            color: var(--text);
        }

        .fp.active-all {
            background: var(--text);
            color: var(--white);
            border-color: var(--text);
        }

        .fp.active-pending {
            background: var(--amber-light);
            color: var(--amber);
            border-color: var(--amber-mid);
        }

        .fp.active-approved {
            background: var(--green-light);
            color: var(--green);
            border-color: var(--green-mid);
        }

        .fp.active-rejected {
            background: var(--red-light);
            color: var(--red);
            border-color: var(--red-mid);
        }

        .fp.active-completed {
            background: var(--blue-light);
            color: var(--blue);
            border-color: #93c5fd;
        }

    /* ── Table card ── */
    .sr-table-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .sr-table-scroll {
        overflow-x: auto;
    }

    .sr-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

        /* Head */
        .sr-table thead tr {
            background: var(--gray-bg);
            border-bottom: 1px solid var(--border);
        }

        .sr-table th {
            padding: 13px 18px;
            text-align: left;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: var(--text-3);
            white-space: nowrap;
        }

        /* Body rows */
        .sr-table tbody tr {
            border-bottom: 1px solid #f3f2ef;
            transition: background .1s;
        }

            .sr-table tbody tr:last-child {
                border-bottom: none;
            }

            .sr-table tbody tr:hover {
                background: #fafaf8;
            }

        .sr-table td {
            padding: 15px 18px;
            vertical-align: middle;
            color: var(--text);
        }

    /* Row number */
    .td-num {
        font-size: 12px;
        color: var(--text-3);
        font-variant-numeric: tabular-nums;
        font-family: var(--font-mono);
        width: 36px;
    }

    /* Employee cell */
    .emp-cell {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .emp-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--blue-light);
        color: var(--blue);
        font-size: 12px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: 1.5px solid #bfdbfe;
        letter-spacing: .5px;
    }

    .emp-name {
        font-size: 13.5px;
        font-weight: 600;
        color: var(--text);
        line-height: 1.3;
    }

    .emp-sub {
        font-size: 11.5px;
        color: var(--text-3);
        font-family: var(--font-mono);
        margin-top: 1px;
    }

    /* Vehicle cell */
    .veh-cell {
    }

    .veh-name {
        font-size: 13.5px;
        font-weight: 600;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

    .inuse-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        background: var(--amber-light);
        color: var(--amber);
        border: 1px solid var(--amber-mid);
        border-radius: 20px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* Reg No */
    .reg-tag {
        font-family: var(--font-mono);
        font-size: 12px;
        font-weight: 500;
        background: var(--gray-bg);
        border: 1px solid var(--border);
        padding: 4px 9px;
        border-radius: 6px;
        color: var(--text-2);
        letter-spacing: .3px;
        white-space: nowrap;
    }

    /* Date cell */
    .date-main {
        font-size: 13px;
        font-weight: 500;
        color: var(--text);
    }

    .date-sub {
        font-size: 11.5px;
        color: var(--text-3);
        margin-top: 1px;
        font-family: var(--font-mono);
    }

    /* Duration chip */
    .dur-chip {
        display: inline-block;
        padding: 4px 10px;
        background: var(--blue-light);
        color: var(--blue);
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
        font-family: var(--font-mono);
        white-space: nowrap;
    }

    /* Purpose */
    .purpose-text {
        max-width: 160px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 13px;
        color: var(--text-2);
    }

    /* Requested on */
    .req-on {
        font-size: 12px;
        color: var(--text-3);
        white-space: nowrap;
        font-family: var(--font-mono);
    }

    /* Status badges */
    .sbadge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .sbadge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
        }

    .sb-pending {
        background: var(--amber-light);
        color: var(--amber);
        border: 1px solid var(--amber-mid);
    }

        .sb-pending::before {
            background: var(--amber);
        }

    .sb-approved {
        background: var(--green-light);
        color: var(--green);
        border: 1px solid var(--green-mid);
    }

        .sb-approved::before {
            background: var(--green);
        }

    .sb-rejected {
        background: var(--red-light);
        color: var(--red);
        border: 1px solid var(--red-mid);
    }

        .sb-rejected::before {
            background: var(--red);
        }

    .sb-completed {
        background: var(--blue-light);
        color: var(--blue);
        border: 1px solid #93c5fd;
    }

        .sb-completed::before {
            background: var(--blue);
        }

    /* Admin notes */
    .note-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 500;
        max-width: 160px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: default;
    }

    .note-ok {
        background: var(--green-light);
        color: #0e7a5c;
        border: 1px solid var(--green-mid);
    }

    .note-bad {
        background: var(--red-light);
        color: var(--red);
        border: 1px solid var(--red-mid);
    }

    .note-none {
        font-size: 12px;
        color: var(--border-dark);
    }

    /* Action buttons */
    .act-group {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .act-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 13px;
        border-radius: var(--radius-sm);
        font-size: 12.5px;
        font-weight: 600;
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: all .15s;
        white-space: nowrap;
        font-family: var(--font);
    }

        .act-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0,0,0,.1);
        }

    .btn-approve {
        background: var(--green-light);
        color: var(--green);
        border-color: var(--green-mid);
    }

        .btn-approve:hover {
            background: #d3f5e8;
        }

    .btn-reject {
        background: var(--red-light);
        color: var(--red);
        border-color: var(--red-mid);
    }

        .btn-reject:hover {
            background: #ffe0e0;
        }

    .btn-complete {
        background: var(--blue-light);
        color: var(--blue);
        border-color: #93c5fd;
    }

        .btn-complete:hover {
            background: #dbeafe;
        }

    .act-none {
        font-size: 12px;
        color: var(--border-dark);
    }

    /* Empty state */
    .sr-empty {
        text-align: center;
        padding: 64px 24px;
        color: var(--text-3);
    }

    .sr-empty-icon {
        font-size: 44px;
        margin-bottom: 14px;
    }

    .sr-empty p {
        font-size: 14px;
        margin: 0;
    }

    /* ── Modal ── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,15,14,.4);
        backdrop-filter: blur(4px);
        z-index: 999;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.open {
            display: flex;
        }

    .modal-box {
        background: var(--white);
        border-radius: var(--radius-lg);
        width: 100%;
        max-width: 460px;
        margin: 16px;
        overflow: hidden;
        box-shadow: 0 24px 64px rgba(0,0,0,.16);
        animation: modalIn .2s cubic-bezier(.34,1.3,.64,1);
    }

    @@keyframes modalIn {
        from {
            transform: scale(.95) translateY(10px);
            opacity: 0;
        }

        to {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
    }

    .modal-hd {
        padding: 20px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
    }

        .modal-hd h5 {
            font-size: 15px;
            font-weight: 700;
            margin: 0;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .hd-approve {
        background: var(--green-light);
        border-color: var(--green-mid);
    }

    .hd-reject {
        background: var(--red-light);
        border-color: var(--red-mid);
    }

    .modal-close {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(0,0,0,.06);
        border: none;
        color: var(--text-2);
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .15s;
    }

        .modal-close:hover {
            background: rgba(0,0,0,.12);
        }

    .modal-bd {
        padding: 24px;
    }

    .modal-req-info {
        background: var(--gray-bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 14px 18px;
        margin-bottom: 20px;
    }

    .mri-vehicle {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 4px;
    }

    .mri-user {
        font-size: 12.5px;
        color: var(--text-3);
    }

    .form-label {
        display: block;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-bottom: 7px;
    }

        .form-label span {
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
            color: var(--text-3);
        }

    .modal-textarea {
        width: 100%;
        padding: 11px 14px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 13.5px;
        color: var(--text);
        background: var(--white);
        box-sizing: border-box;
        outline: none;
        resize: vertical;
        font-family: var(--font);
        transition: border-color .15s, box-shadow .15s;
        min-height: 92px;
        line-height: 1.5;
    }

        .modal-textarea:focus {
            border-color: var(--green);
            box-shadow: 0 0 0 3px rgba(22,163,122,.1);
        }

        .modal-textarea.ta-reject:focus {
            border-color: var(--red);
            box-shadow: 0 0 0 3px rgba(184,53,53,.1);
        }

    .modal-hint {
        font-size: 11.5px;
        color: var(--text-3);
        margin-top: 6px;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-cancel {
        flex: 1;
        padding: 11px;
        background: var(--gray-bg);
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        font-size: 13.5px;
        font-weight: 600;
        color: var(--text-2);
        cursor: pointer;
        font-family: var(--font);
        transition: background .15s;
    }

        .btn-cancel:hover {
            background: #eeede9;
        }

    .btn-confirm {
        flex: 2;
        padding: 11px;
        border: none;
        border-radius: var(--radius-sm);
        font-size: 13.5px;
        font-weight: 700;
        cursor: pointer;
        font-family: var(--font);
        transition: opacity .15s, transform .1s;
        color: #fff;
    }

        .btn-confirm:hover {
            opacity: .9;
            transform: translateY(-1px);
        }

    .confirm-approve {
        background: var(--green);
    }

    .confirm-reject {
        background: var(--red);
    }
    /* Overdue tag */
    .overdue-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        background: #fff1f1;
        color: #b83535;
        border: 1px solid #f5bfbf;
        border-radius: 20px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* Overdue row highlight */
    .row-overdue {
        background: #fffbf0 !important;
    }

        .row-overdue:hover {
            background: #fff6e0 !important;
        }

        /* Overdue row left border accent */
        .row-overdue td:first-child {
            border-left: 3px solid #c47d10;
        }

    /* Combined in-use + overdue tag */
    .inuse-overdue-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        background: #fff1f1;
        color: #b83535;
        border: 1px solid #f5bfbf;
        border-radius: 20px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
    }   
</style>

<div class="ab-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="ab-main">
        @await Html.PartialAsync("_AdminTopbar")
        <div class="ab-content">

            <!-- Page header -->
            <div class="sr-page-header">
                <h1>Vehicle Requests</h1>
                <p>Review, approve or reject incoming vehicle requests from employees.</p>
            </div>

            <!-- Flash messages -->
            @if (TempData["Success"] != null)
            {
                <div class="flash flash-ok">✅ @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="flash flash-err">⚠️ @TempData["Error"]</div>
            }

            <!-- Summary stats -->
            <div class="sr-stats">
                <div class="stat-card stat-total" onclick="setFilter('all', document.querySelector('.fp[data-f=all]'))">
                    <div class="stat-label">Total</div>
                    <div class="stat-value">@Model.TotalCount</div>
                </div>
                <div class="stat-card stat-pending" onclick="setFilter('pending', document.querySelector('.fp[data-f=pending]'))">
                    <div class="stat-label">Pending</div>
                    <div class="stat-value">@Model.PendingCount</div>
                </div>
                <div class="stat-card stat-approved" onclick="setFilter('approved', document.querySelector('.fp[data-f=approved]'))">
                    <div class="stat-label">Approved</div>
                    <div class="stat-value">@Model.ApprovedCount</div>
                </div>
                <div class="stat-card stat-rejected" onclick="setFilter('rejected', document.querySelector('.fp[data-f=rejected]'))">
                    <div class="stat-label">Rejected</div>
                    <div class="stat-value">@Model.RejectedCount</div>
                </div>
                <div class="stat-card stat-completed" onclick="setFilter('completed', document.querySelector('.fp[data-f=completed]'))">
                    <div class="stat-label">Completed</div>
                    <div class="stat-value">@Model.CompletedCount</div>
                </div>
            </div>

            <!-- Toolbar -->
            <div class="sr-toolbar">
                <div class="sr-search-wrap">
                    <span class="sr-search-icon">🔍</span>
                    <input class="sr-search" id="reqSearch" type="text"
                           placeholder="Search by name, vehicle, emp no, reg no…" />
                </div>
                <div class="filter-pills">
                    <button class="fp active-all" data-f="all" onclick="setFilter('all',this)">All</button>
                    <button class="fp" data-f="pending" onclick="setFilter('pending',this)">Pending</button>
                    <button class="fp" data-f="approved" onclick="setFilter('approved',this)">Approved</button>
                    <button class="fp" data-f="rejected" onclick="setFilter('rejected',this)">Rejected</button>
                    <button class="fp" data-f="completed" onclick="setFilter('completed',this)">Completed</button>
                </div>
            </div>

            <!-- Table -->
            @if (!Model.AllRequests.Any())
            {
                <div class="sr-table-card">
                    <div class="sr-empty">
                        <div class="sr-empty-icon">📭</div>
                        <p>No vehicle requests have been submitted yet.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="sr-table-card">
                    <div class="sr-table-scroll">
                        <table class="sr-table" id="reqTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Employee</th>
                                    <th>Vehicle</th>
                                    <th>Reg No</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th>Duration</th>
                                    <th>Purpose</th>
                                    <th>Requested On</th>
                                    <th>Status</th>
                                    <th>Admin Notes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                }
                                @foreach (var r in Model.AllRequests)
                                {
                                    // A vehicle is "actively in use" if another approved request's window covers now
                                    bool vehicleCurrentlyInUse = Model.AllRequests.Any(other =>
                                    other.VehicleId == r.VehicleId &&
                                    other.Id != r.Id &&
                                    other.Status == "Approved" &&
                                    other.StartTime <= DateTime.Now &&
                                    other.EndTime >= DateTime.Now);

                                    // A vehicle is "overdue" if THIS row is approved and past its EndTime (not yet completed)
                                    bool thisRowIsOverdue = r.Status == "Approved" && r.EndTime < DateTime.Now;

                                    // Another approved request for same vehicle is overdue (blocking this vehicle)
                                    bool vehicleIsOverdue = Model.AllRequests.Any(other =>
                                    other.VehicleId == r.VehicleId &&
                                    other.Id != r.Id &&
                                    other.Status == "Approved" &&
                                    other.EndTime < DateTime.Now);

                                    double hrs = (r.EndTime - r.StartTime).TotalHours;
                                    string dur = hrs >= 24
                                    ? $"{(int)(hrs / 24)}d {(int)(hrs % 24)}h"
                                    : hrs >= 1
                                    ? $"{(int)hrs}h {(int)((hrs % 1) * 60)}m"
                                    : $"{(int)(hrs * 60)}m";

                                    string sbClass = r.Status.ToLower() switch
                                    {
                                        "pending" => "sb-pending",
                                        "approved" => "sb-approved",
                                        "rejected" => "sb-rejected",
                                        "completed" => "sb-completed",
                                        _ => "sb-pending"
                                    };

                                    string initials = string.Join("", r.UserName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2).Select(w => w[0])).ToUpper();

                                    string jsName = r.VehicleName.Replace("'", "\\'");
                                    string jsUser = r.UserName.Replace("'", "\\'");
                                    string jsEmp = r.EmployeeNumber.Replace("'", "\\'");

                                    <tr class="req-row @(thisRowIsOverdue ? "row-overdue" : "")"
                                        data-status="@r.Status.ToLower()"
                                        data-search="@r.UserName.ToLower() @r.EmployeeNumber.ToLower() @r.VehicleName.ToLower() @r.RegistrationNumber.ToLower() @(vehicleCurrentlyInUse || vehicleIsOverdue ? "in use" : "") @(thisRowIsOverdue || vehicleIsOverdue ? "overdue" : "")">

                                        <!-- # -->
                                        <td class="td-num">@i</td>

                                        <!-- Employee -->
                                        <td>
                                            <div class="emp-cell">
                                                <div class="emp-avatar">@initials</div>
                                                <div>
                                                    <div class="emp-name">@r.UserName</div>
                                                    <div class="emp-sub">@r.EmployeeNumber · @r.UserMobile</div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Vehicle -->
                                        <td>
                                            <div class="veh-name">
                                                @r.VehicleName
                                                @if (thisRowIsOverdue)
                                                {
                                                    <span class="overdue-tag">⏰ Overdue</span>
                                                }
                                                else if (vehicleIsOverdue && r.Status == "Pending")
                                                {
                                                    <span class="inuse-overdue-tag">⚠️ In Use · Overdue</span>
                                                }
                                                else if (vehicleCurrentlyInUse && r.Status == "Pending")
                                                {
                                                    <span class="inuse-tag">🔑 In Use</span>
                                                }
                                            </div>
                                        </td>

                                        <!-- Reg No -->
                                        <td><span class="reg-tag">@r.RegistrationNumber</span></td>

                                        <!-- Start -->
                                        <td>
                                            <div class="date-main">@r.StartTime.ToString("dd MMM yyyy")</div>
                                            <div class="date-sub">@r.StartTime.ToString("hh:mm tt")</div>
                                        </td>

                                        <!-- End -->
                                        <td>
                                            <div class="date-main">@r.EndTime.ToString("dd MMM yyyy")</div>
                                            <div class="date-sub">@r.EndTime.ToString("hh:mm tt")</div>
                                        </td>

                                        <!-- Duration -->
                                        <td><span class="dur-chip">@dur</span></td>

                                        <!-- Purpose -->
                                        <td>
                                            <div class="purpose-text" title="@r.Purpose">
                                                @(string.IsNullOrEmpty(r.Purpose) ? "—" : r.Purpose)
                                            </div>
                                        </td>

                                        <!-- Requested On -->
                                        <td>
                                            <div class="req-on">
                                                @r.CreatedAt.ToString("dd MMM yy")<br />
                                                @r.CreatedAt.ToString("hh:mm tt")
                                            </div>
                                        </td>

                                        <!-- Status -->
                                        <td><span class="sbadge @sbClass">@r.Status</span></td>

                                        <!-- Admin Notes -->
                                        <td>
                                            @if (!string.IsNullOrEmpty(r.AdminNotes))
                                            {
                                                string noteClass = (r.Status == "Approved" || r.Status == "Completed")
                                                ? "note-ok" : "note-bad";
                                                <span class="note-pill @noteClass" title="@r.AdminNotes">
                                                    💬 @r.AdminNotes
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="note-none">—</span>
                                            }
                                        </td>

                                        <!-- Actions -->
                                        <td>
                                            <div class="act-group">
                                                @if (r.Status == "Pending")
                                                {
                                                    <button type="button" class="act-btn btn-approve"
                                                            onclick="openApprove(@r.Id,'@jsUser','@jsEmp','@jsName')">
                                                        ✔ Approve
                                                    </button>
                                                    <button type="button" class="act-btn btn-reject"
                                                            onclick="openReject(@r.Id,'@jsUser','@jsEmp','@jsName')">
                                                        ✘ Reject
                                                    </button>
                                                }
                                                else if (r.Status == "Approved")
                                                {
                                                    <form asp-action="CompleteRequest" asp-controller="Autobase"
                                                          method="post" style="display:inline;">
                                                        <input type="hidden" name="id" value="@r.Id" />
                                                        <button type="submit" class="act-btn btn-complete">
                                                            ✔ Mark Returned
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="act-none">—</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<!-- ── Approve Modal ── -->
<div class="modal-overlay" id="approveModal">
    <div class="modal-box">
        <div class="modal-hd hd-approve">
            <h5>✔ Approve Request</h5>
            <button class="modal-close" onclick="closeModals()">✕</button>
        </div>
        <div class="modal-bd">
            <div class="modal-req-info">
                <div class="mri-vehicle" id="ap-vehicle">—</div>
                <div class="mri-user" id="ap-user">—</div>
            </div>
            <form asp-action="ApproveRequest" asp-controller="Autobase" method="post">
                <input type="hidden" name="Id" id="ap-id" />
                <label class="form-label">Approval Notes <span>(optional)</span></label>
                <textarea class="modal-textarea" name="Notes" id="ap-notes"
                          placeholder="e.g. Approved for official use. Please return by end of day."></textarea>
                <p class="modal-hint">These notes will be visible to the employee in their request history.</p>
                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeModals()">Cancel</button>
                    <button type="submit" class="btn-confirm confirm-approve">✔ Confirm Approval</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ── Reject Modal ── -->
<div class="modal-overlay" id="rejectModal">
    <div class="modal-box">
        <div class="modal-hd hd-reject">
            <h5>✘ Reject Request</h5>
            <button class="modal-close" onclick="closeModals()">✕</button>
        </div>
        <div class="modal-bd">
            <div class="modal-req-info">
                <div class="mri-vehicle" id="rj-vehicle">—</div>
                <div class="mri-user" id="rj-user">—</div>
            </div>
            <form asp-action="RejectRequest" asp-controller="Autobase" method="post">
                <input type="hidden" name="Id" id="rj-id" />
                <label class="form-label">Reason for Rejection <span>(recommended)</span></label>
                <textarea class="modal-textarea ta-reject" name="Notes" id="rj-notes"
                          placeholder="e.g. Vehicle already booked. Please try a different date or time."></textarea>
                <p class="modal-hint">The employee will see this reason alongside their rejected request.</p>
                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeModals()">Cancel</button>
                    <button type="submit" class="btn-confirm confirm-reject">✘ Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* ── Filter / Search ── */
        let activeFilter = 'all';

        function setFilter(status, btn) {
            activeFilter = status;
            // Reset all pills
            document.querySelectorAll('.fp').forEach(b => {
                b.className = 'fp';
            });
            // Activate clicked
            if (btn) btn.classList.add('active-' + status);
            applyFilters();
        }

        document.getElementById('reqSearch').addEventListener('input', applyFilters);

        function applyFilters() {
            const q = document.getElementById('reqSearch').value.toLowerCase().trim();
            document.querySelectorAll('.req-row').forEach(row => {
                const statusOk = activeFilter === 'all' || row.dataset.status === activeFilter;
                const searchOk = !q || row.dataset.search.includes(q);
                row.style.display = statusOk && searchOk ? '' : 'none';
            });
        }

        // Stat card click — sync pill active state
        document.querySelectorAll('.stat-card').forEach(card => {
            card.addEventListener('click', function() {
                const map = {
                    'stat-total': 'all', 'stat-pending': 'pending',
                    'stat-approved': 'approved', 'stat-rejected': 'rejected',
                    'stat-completed': 'completed'
                };
                for (const [cls, status] of Object.entries(map)) {
                    if (this.classList.contains(cls)) {
                        const pill = document.querySelector(`.fp[data-f="${status}"]`);
                        setFilter(status, pill);
                        break;
                    }
                }
            });
        });

        /* ── Modals ── */
        function openApprove(id, userName, empNo, vehicleName) {
            document.getElementById('ap-id').value              = id;
            document.getElementById('ap-vehicle').textContent   = vehicleName;
            document.getElementById('ap-user').textContent      = userName + '  ·  ' + empNo;
            document.getElementById('ap-notes').value           = '';
            document.getElementById('approveModal').classList.add('open');
        }

        function openReject(id, userName, empNo, vehicleName) {
            document.getElementById('rj-id').value              = id;
            document.getElementById('rj-vehicle').textContent   = vehicleName;
            document.getElementById('rj-user').textContent      = userName + '  ·  ' + empNo;
            document.getElementById('rj-notes').value           = '';
            document.getElementById('rejectModal').classList.add('open');
        }

        function closeModals() {
            document.getElementById('approveModal').classList.remove('open');
            document.getElementById('rejectModal').classList.remove('open');
        }

        ['approveModal', 'rejectModal'].forEach(id => {
            document.getElementById(id).addEventListener('click', function(e) {
                if (e.target === this) closeModals();
            });
        });
    </script>
}
