@model autobase.Models.ViewModels.SeeRequestViewModel
@{
    ViewData["Title"] = "See Requests";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />

<style>
    :root {
        --green: #1d9e75;
        --green-bg: #e1f5ee;
        --green-mid: #9fe1cb;
        --blue: #185fa5;
        --blue-bg: #e6f1fb;
        --amber: #ba7517;
        --amber-bg: #faeeda;
        --red: #a32d2d;
        --red-bg: #fcebeb;
        --red-mid: #f7c1c1;
        --gray-bg: #f9f8f4;
        --border: #e8e6de;
        --text: #2c2c2a;
        --muted: #888780;
        --radius: 14px;
    }

    /* ── Summary strip ── */
    .req-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 14px;
        margin-bottom: 26px;
    }

    .req-stat {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 16px 18px;
        position: relative;
        overflow: hidden;
    }

        .req-stat::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
        }

    .rs-total::before {
        background: var(--muted);
    }

    .rs-pending::before {
        background: var(--amber);
    }

    .rs-approved::before {
        background: var(--green);
    }

    .rs-rejected::before {
        background: var(--red);
    }

    .rs-completed::before {
        background: var(--blue);
    }

    .rs-label {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 8px;
    }

    .rs-num {
        font-size: 32px;
        font-weight: 700;
        font-family: Georgia, serif;
        color: var(--text);
        line-height: 1;
    }

    /* ── Filter bar ── */
    .filter-bar {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .filter-search {
        flex: 1;
        min-width: 220px;
        padding: 9px 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 13px;
        background: #fff;
        color: var(--text);
        outline: none;
        transition: border-color .2s;
    }

        .filter-search:focus {
            border-color: var(--blue);
        }

    .filter-btn {
        padding: 8px 15px;
        border: 1px solid var(--border);
        border-radius: 8px;
        background: #fff;
        font-size: 12px;
        font-weight: 700;
        color: var(--muted);
        cursor: pointer;
        transition: all .15s;
        white-space: nowrap;
    }

        .filter-btn:hover,
        .filter-btn.active {
            border-color: var(--blue);
            color: var(--blue);
            background: var(--blue-bg);
        }

        .filter-btn.f-pending.active {
            border-color: var(--amber);
            color: var(--amber);
            background: var(--amber-bg);
        }

        .filter-btn.f-approved.active {
            border-color: var(--green);
            color: var(--green);
            background: var(--green-bg);
        }

        .filter-btn.f-rejected.active {
            border-color: var(--red);
            color: var(--red);
            background: var(--red-bg);
        }

        .filter-btn.f-completed.active {
            border-color: var(--blue);
            color: var(--blue);
            background: var(--blue-bg);
        }

    /* ── Table ── */
    .req-table-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
    }

    .req-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .req-table thead tr {
            background: var(--gray-bg);
            border-bottom: 1px solid var(--border);
        }

        .req-table th {
            padding: 11px 14px;
            text-align: left;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: var(--muted);
            white-space: nowrap;
        }

        .req-table tbody tr {
            border-bottom: 1px solid #f1efe8;
            transition: background .12s;
        }

            .req-table tbody tr:last-child {
                border-bottom: none;
            }

            .req-table tbody tr:hover {
                background: #fafaf7;
            }

        .req-table td {
            padding: 11px 14px;
            color: var(--text);
            vertical-align: middle;
        }

    .reg-mono {
        font-family: 'Courier New', monospace;
        font-size: 11px;
        background: #f1efe8;
        padding: 2px 7px;
        border-radius: 4px;
        color: #444;
    }

    .user-cell {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .user-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--blue-bg);
        color: var(--blue);
        font-size: 11px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .user-name {
        font-weight: 600;
        font-size: 13px;
    }

    .user-emp {
        font-size: 11px;
        color: var(--muted);
    }

    /* Status badges */
    .sbadge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

        .sbadge::before {
            content: '';
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
        }

    .sb-pending {
        background: var(--amber-bg);
        color: var(--amber);
    }

        .sb-pending::before {
            background: var(--amber);
        }

    .sb-approved {
        background: var(--green-bg);
        color: var(--green);
    }

        .sb-approved::before {
            background: var(--green);
        }

    .sb-rejected {
        background: var(--red-bg);
        color: var(--red);
    }

        .sb-rejected::before {
            background: var(--red);
        }

    .sb-completed {
        background: var(--blue-bg);
        color: var(--blue);
    }

        .sb-completed::before {
            background: var(--blue);
        }

    /* Action buttons */
    .act-btn {
        padding: 5px 11px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        transition: opacity .15s;
        white-space: nowrap;
    }

        .act-btn:hover {
            opacity: .82;
        }

    .btn-approve {
        background: var(--green-bg);
        color: var(--green);
    }

    .btn-reject {
        background: var(--red-bg);
        color: var(--red);
    }

    .btn-complete {
        background: var(--blue-bg);
        color: var(--blue);
    }

    .act-group {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .dur-chip {
        font-weight: 700;
        font-size: 12px;
        color: var(--blue);
    }

    /* Admin notes pill */
    .admin-note-pill {
        display: inline-block;
        padding: 3px 9px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 500;
        max-width: 160px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        cursor: default;
        vertical-align: middle;
    }

    .note-approved {
        background: var(--green-bg);
        color: var(--green);
    }

    .note-rejected {
        background: var(--red-bg);
        color: var(--red);
    }

    /* Empty / Flash */
    .req-empty {
        text-align: center;
        padding: 52px 24px;
        color: var(--muted);
    }

        .req-empty .ei {
            font-size: 40px;
            margin-bottom: 10px;
        }

    .flash-ok {
        background: var(--green-bg);
        color: var(--green);
        border: 1px solid var(--green-mid);
        border-radius: 10px;
        padding: 12px 18px;
        margin-bottom: 18px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .flash-err {
        background: var(--red-bg);
        color: var(--red);
        border: 1px solid var(--red-mid);
        border-radius: 10px;
        padding: 12px 18px;
        margin-bottom: 18px;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ── Modal ── */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(44,44,42,.5);
        backdrop-filter: blur(3px);
        z-index: 999;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.open {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: var(--radius);
        width: 100%;
        max-width: 440px;
        margin: 16px;
        overflow: hidden;
        animation: modalIn .22s cubic-bezier(.34,1.4,.64,1);
        box-shadow: 0 16px 48px rgba(0,0,0,.14);
    }

    @@keyframes modalIn {
        from {
            transform: scale(.94) translateY(12px);
            opacity: 0;
        }

        to {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
    }

    .modal-hd {
        padding: 18px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--border);
    }

        .modal-hd h5 {
            font-size: 15px;
            font-weight: 700;
            margin: 0;
            color: var(--text);
        }

        .modal-hd.hd-approve {
            background: var(--green-bg);
            border-color: var(--green-mid);
        }

        .modal-hd.hd-reject {
            background: var(--red-bg);
            border-color: var(--red-mid);
        }

    .modal-close {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: none;
        border: 1px solid var(--border);
        color: var(--muted);
        font-size: 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .15s;
    }

        .modal-close:hover {
            background: var(--border);
        }

    .modal-bd {
        padding: 22px;
    }

    .modal-req-info {
        background: var(--gray-bg);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 18px;
    }

    .mri-name {
        font-size: 14px;
        font-weight: 700;
        color: var(--text);
        margin-bottom: 4px;
    }

    .mri-meta {
        font-size: 12px;
        color: var(--muted);
    }

    .notes-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
    }

        .notes-label span {
            font-weight: 400;
            text-transform: none;
            letter-spacing: 0;
        }

    .notes-textarea {
        width: 100%;
        padding: 10px 13px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 13px;
        color: var(--text);
        background: #fff;
        box-sizing: border-box;
        outline: none;
        resize: vertical;
        font-family: 'Segoe UI', sans-serif;
        transition: border-color .15s;
        min-height: 88px;
    }

        .notes-textarea:focus {
            border-color: var(--green);
            box-shadow: 0 0 0 3px rgba(29,158,117,.1);
        }

        .notes-textarea.reject:focus {
            border-color: var(--red);
            box-shadow: 0 0 0 3px rgba(163,45,45,.1);
        }

    .notes-hint {
        font-size: 11px;
        color: var(--muted);
        margin-top: 5px;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 18px;
    }

    .btn-cancel {
        flex: 1;
        padding: 10px;
        background: var(--gray-bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        font-family: 'Segoe UI', sans-serif;
        transition: background .15s;
    }

        .btn-cancel:hover {
            background: var(--border);
        }

    .btn-confirm {
        flex: 2;
        padding: 10px;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        font-family: 'Segoe UI', sans-serif;
        transition: opacity .15s, transform .1s;
    }

        .btn-confirm:hover {
            opacity: .88;
            transform: translateY(-1px);
        }

        .btn-confirm.confirm-approve {
            background: var(--green);
            color: #fff;
        }

        .btn-confirm.confirm-reject {
            background: var(--red);
            color: #fff;
        }
</style>

<div class="ab-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="ab-main">
        @await Html.PartialAsync("_AdminTopbar")
        <div class="ab-content">

            <div class="page-header">
                <div class="page-title">📋 Vehicle Requests</div>
                <div class="page-sub">Review, approve or reject user vehicle requests.</div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="flash-ok">✅ @TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="flash-err">⚠️ @TempData["Error"]</div>
            }

            @* Summary *@
            <div class="req-summary">
                <div class="req-stat rs-total">    <div class="rs-label">Total</div>     <div class="rs-num">@Model.TotalCount</div>     </div>
                <div class="req-stat rs-pending">  <div class="rs-label">Pending</div>   <div class="rs-num">@Model.PendingCount</div>   </div>
                <div class="req-stat rs-approved"> <div class="rs-label">Approved</div>  <div class="rs-num">@Model.ApprovedCount</div>  </div>
                <div class="req-stat rs-rejected"> <div class="rs-label">Rejected</div>  <div class="rs-num">@Model.RejectedCount</div>  </div>
                <div class="req-stat rs-completed"><div class="rs-label">Completed</div> <div class="rs-num">@Model.CompletedCount</div> </div>
            </div>

            @* Filter bar *@
            <div class="filter-bar">
                <input class="filter-search" id="reqSearch" type="text" placeholder="🔍  Search by name, vehicle, emp no, reg…" />
                <button class="filter-btn active" onclick="setFilter('all',this)">All</button>
                <button class="filter-btn f-pending" onclick="setFilter('pending',this)">Pending</button>
                <button class="filter-btn f-approved" onclick="setFilter('approved',this)">Approved</button>
                <button class="filter-btn f-rejected" onclick="setFilter('rejected',this)">Rejected</button>
                <button class="filter-btn f-completed" onclick="setFilter('completed',this)">Completed</button>
            </div>

            @* Table *@
            @if (!Model.AllRequests.Any())
            {
                <div class="req-table-card">
                    <div class="req-empty"><div class="ei">📭</div><p>No vehicle requests have been submitted yet.</p></div>
                </div>
            }
            else
            {
                <div class="req-table-card">
                    <div style="overflow-x:auto;">
                        <table class="req-table" id="reqTable">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Employee</th>
                                    <th>Vehicle</th>
                                    <th>Reg No</th>
                                    <th>Start</th>
                                    <th>End</th>
                                    <th>Duration</th>
                                    <th>Purpose</th>
                                    <th>Requested On</th>
                                    <th>Status</th>
                                    <th>Admin Notes</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int i = 1;
                                }
                                @foreach (var r in Model.AllRequests)
                                {
                                    double hrs = (r.EndTime - r.StartTime).TotalHours;
                                    string dur = hrs >= 24 ? $"{(int)(hrs / 24)}d {(int)(hrs % 24)}h"
                                    : hrs >= 1 ? $"{(int)hrs}h {(int)((hrs % 1) * 60)}m"
                                    : $"{(int)(hrs * 60)}m";

                                    string sbClass = r.Status.ToLower() switch
                                    {
                                        "pending" => "sb-pending",
                                        "approved" => "sb-approved",
                                        "rejected" => "sb-rejected",
                                        "completed" => "sb-completed",
                                        _ => "sb-pending"
                                    };

                                    string initials = string.Join("", r.UserName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2).Select(w => w[0])).ToUpper();

                                    string jsName = r.VehicleName.Replace("'", "\\'");
                                    string jsUser = r.UserName.Replace("'", "\\'");
                                    string jsEmp = r.EmployeeNumber.Replace("'", "\\'");

                                    <tr class="req-row"
                                        data-status="@r.Status.ToLower()"
                                        data-search="@r.UserName.ToLower() @r.EmployeeNumber.ToLower() @r.VehicleName.ToLower() @r.RegistrationNumber.ToLower()">

                                        <td style="color:#b4b2a9;font-size:11px;">@i</td>

                                        <td>
                                            <div class="user-cell">
                                                <div class="user-avatar">@initials</div>
                                                <div>
                                                    <div class="user-name">@r.UserName</div>
                                                    <div class="user-emp">@r.EmployeeNumber &nbsp;·&nbsp; @r.UserMobile</div>
                                                </div>
                                            </div>
                                        </td>

                                        <td style="font-weight:600;">@r.VehicleName</td>
                                        <td><span class="reg-mono">@r.RegistrationNumber</span></td>

                                        <td style="font-size:12px;white-space:nowrap;">
                                            @r.StartTime.ToString("dd MMM yy")<br />
                                            <span style="color:var(--muted)">@r.StartTime.ToString("hh:mm tt")</span>
                                        </td>
                                        <td style="font-size:12px;white-space:nowrap;">
                                            @r.EndTime.ToString("dd MMM yy")<br />
                                            <span style="color:var(--muted)">@r.EndTime.ToString("hh:mm tt")</span>
                                        </td>

                                        <td><span class="dur-chip">@dur</span></td>

                                        <td style="color:var(--muted);font-size:12px;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                            @(string.IsNullOrEmpty(r.Purpose) ? "—" : r.Purpose)
                                        </td>

                                        <td style="font-size:11px;color:var(--muted);white-space:nowrap;">
                                            @r.CreatedAt.ToString("dd MMM yy, hh:mm tt")
                                        </td>

                                        <td><span class="sbadge @sbClass">@r.Status</span></td>

                                        @* ── Admin Notes ── *@
                                        <td>
                                            @if (!string.IsNullOrEmpty(r.AdminNotes))
                                            {
                                                string noteClass = (r.Status == "Approved" || r.Status == "Completed")
                                                ? "note-approved" : "note-rejected";
                                                <span class="admin-note-pill @noteClass" title="@r.AdminNotes">
                                                    💬 @r.AdminNotes
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="font-size:11px;color:#ccc;">—</span>
                                            }
                                        </td>

                                        @* ── Actions ── *@
                                        <td>
                                            <div class="act-group">
                                                @if (r.Status == "Pending")
                                                {
                                                    <button type="button" class="act-btn btn-approve"
                                                            onclick="openApprove(@r.Id,'@jsUser','@jsEmp','@jsName')">
                                                        ✔ Approve
                                                    </button>
                                                    <button type="button" class="act-btn btn-reject"
                                                            onclick="openReject(@r.Id,'@jsUser','@jsEmp','@jsName')">
                                                        ✘ Reject
                                                    </button>
                                                }
                                                else if (r.Status == "Approved")
                                                {
                                                    <form asp-action="CompleteRequest" asp-controller="Autobase" method="post" style="display:inline;">
                                                        <input type="hidden" name="id" value="@r.Id" />
                                                        <button type="submit" class="act-btn btn-complete">✔ Mark Returned</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span style="font-size:11px;color:var(--muted);">—</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@* ── Approve Modal ── *@
<div class="modal-overlay" id="approveModal">
    <div class="modal-box">
        <div class="modal-hd hd-approve">
            <h5>✔ Approve Request</h5>
            <button class="modal-close" onclick="closeModals()">✕</button>
        </div>
        <div class="modal-bd">
            <div class="modal-req-info">
                <div class="mri-name" id="ap-vehicle">—</div>
                <div class="mri-meta" id="ap-user">—</div>
            </div>
            <form asp-action="ApproveRequest" asp-controller="Autobase" method="post">
                <input type="hidden" name="Id" id="ap-id" />
                <label class="notes-label">Approval Notes <span>(optional)</span></label>
                <textarea class="notes-textarea" name="Notes" id="ap-notes"
                          placeholder="e.g. Approved for official use. Please return by end of day."></textarea>
                <p class="notes-hint">These notes will be visible to the employee in their request history.</p>
                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeModals()">Cancel</button>
                    <button type="submit" class="btn-confirm confirm-approve">✔ Confirm Approval</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Reject Modal ── *@
<div class="modal-overlay" id="rejectModal">
    <div class="modal-box">
        <div class="modal-hd hd-reject">
            <h5>✘ Reject Request</h5>
            <button class="modal-close" onclick="closeModals()">✕</button>
        </div>
        <div class="modal-bd">
            <div class="modal-req-info">
                <div class="mri-name" id="rj-vehicle">—</div>
                <div class="mri-meta" id="rj-user">—</div>
            </div>
            <form asp-action="RejectRequest" asp-controller="Autobase" method="post">
                <input type="hidden" name="Id" id="rj-id" />
                <label class="notes-label">Reason for Rejection <span>(recommended)</span></label>
                <textarea class="notes-textarea reject" name="Notes" id="rj-notes"
                          placeholder="e.g. Vehicle already booked. Please try a different date or time."></textarea>
                <p class="notes-hint">The employee will see this reason alongside their rejected request.</p>
                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeModals()">Cancel</button>
                    <button type="submit" class="btn-confirm confirm-reject">✘ Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* ── Filter / Search ── */
        let activeFilter = 'all';

        function setFilter(status, btn) {
            activeFilter = status;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            applyFilters();
        }

        document.getElementById('reqSearch').addEventListener('input', applyFilters);

        function applyFilters() {
            const q = document.getElementById('reqSearch').value.toLowerCase().trim();
            document.querySelectorAll('.req-row').forEach(row => {
                const statusOk = activeFilter === 'all' || row.dataset.status === activeFilter;
                const searchOk = !q || row.dataset.search.includes(q);
                row.style.display = statusOk && searchOk ? '' : 'none';
            });
        }

        /* ── Modals ── */
        function openApprove(id, userName, empNo, vehicleName) {
            document.getElementById('ap-id').value = id;
            document.getElementById('ap-vehicle').textContent = vehicleName;
            document.getElementById('ap-user').textContent    = userName + '  ·  ' + empNo;
            document.getElementById('ap-notes').value = '';
            document.getElementById('approveModal').classList.add('open');
        }

        function openReject(id, userName, empNo, vehicleName) {
            document.getElementById('rj-id').value = id;
            document.getElementById('rj-vehicle').textContent = vehicleName;
            document.getElementById('rj-user').textContent    = userName + '  ·  ' + empNo;
            document.getElementById('rj-notes').value = '';
            document.getElementById('rejectModal').classList.add('open');
        }

        function closeModals() {
            document.getElementById('approveModal').classList.remove('open');
            document.getElementById('rejectModal').classList.remove('open');
        }

        ['approveModal', 'rejectModal'].forEach(id => {
            document.getElementById(id).addEventListener('click', function(e) {
                if (e.target === this) closeModals();
            });
        });
    </script>
}
