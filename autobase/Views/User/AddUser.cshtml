@model autobase.Models.ViewModels.AddUserViewModel
@{
    ViewData["Title"] = "Add User";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<style>
    .form-wrapper {
        max-width: 700px;
    }

    .success-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f0fff4;
        border: 1px solid #9ae6b4;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 13px;
        color: #276749;
        margin-bottom: 20px;
    }

        .success-alert svg {
            width: 15px;
            height: 15px;
            flex-shrink: 0;
            stroke: #276749;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .form-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        margin-bottom: 16px;
    }

    .form-card-header {
        padding: 16px 24px;
        border-bottom: 1px solid var(--border);
        background: var(--bg);
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .form-card-header svg {
            width: 16px;
            height: 16px;
            stroke: var(--accent-dark);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .form-card-header span {
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
        }

    .form-card-body {
        padding: 24px;
    }

    .form-card-footer {
        padding: 18px 24px;
        border-top: 1px solid var(--border);
        background: var(--bg);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 22px;
    }

        .form-grid .span-2 {
            grid-column: 1 / -1;
        }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .form-label {
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .req {
        width: 5px;
        height: 5px;
        background: var(--danger);
        border-radius: 50%;
        display: inline-block;
        margin-bottom: 1px;
    }

    .form-control {
        height: 44px;
        padding: 0 14px;
        background: #fff;
        border: 1.5px solid #dde1ea;
        border-radius: 10px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        color: var(--text);
        outline: none;
        transition: border-color 0.15s, box-shadow 0.15s;
        width: 100%;
    }

        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(245,197,24,0.15);
        }

        .form-control::placeholder {
            color: #c0c6d4;
        }

    .field-error {
        font-size: 12px;
        color: var(--danger);
    }
    /* Password toggle */
    .pw-wrap {
        position: relative;
    }

        .pw-wrap .form-control {
            padding-right: 44px;
        }

    .pw-toggle {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: var(--muted);
        display: flex;
        align-items: center;
        transition: color 0.15s;
    }

        .pw-toggle:hover {
            color: var(--text);
        }

        .pw-toggle svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
    /* Role cards */
    .role-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .role-radio {
        display: none;
    }

    .role-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 16px 12px;
        border: 1.5px solid #dde1ea;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.15s;
        background: var(--bg);
        text-align: center;
    }

        .role-label:hover {
            border-color: var(--accent);
            background: rgba(245,197,24,0.06);
        }

    .role-radio:checked + .role-label {
        border-color: var(--accent);
        background: rgba(245,197,24,0.10);
        box-shadow: 0 0 0 3px rgba(245,197,24,0.12);
    }

    .role-label svg {
        width: 22px;
        height: 22px;
        stroke: var(--muted);
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: stroke 0.15s;
    }

    .role-radio:checked + .role-label svg {
        stroke: var(--accent-dark);
    }

    .role-label .role-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--text);
    }

    .role-label .role-desc {
        font-size: 11px;
        color: var(--muted);
    }
    /* Buttons */
    .btn-save {
        height: 42px;
        padding: 0 28px;
        background: var(--accent);
        border: none;
        border-radius: 9px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 700;
        color: #111;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .btn-save:hover {
            background: var(--accent-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(245,197,24,0.35);
        }

        .btn-save svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .btn-cancel {
        height: 42px;
        padding: 0 22px;
        background: #fff;
        border: 1.5px solid #dde1ea;
        border-radius: 9px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        transition: all 0.15s;
        text-decoration: none;
        display: flex;
        align-items: center;
    }

        .btn-cancel:hover {
            border-color: #aaa;
            color: var(--text);
        }

    .info-box {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        background: rgba(59,130,246,0.07);
        border: 1px solid rgba(59,130,246,0.2);
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        color: #1d4ed8;
        margin-bottom: 20px;
    }

        .info-box svg {
            width: 15px;
            height: 15px;
            flex-shrink: 0;
            margin-top: 1px;
            stroke: #1d4ed8;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    @@media (max-width: 640px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

            .form-grid .span-2 {
                grid-column: 1;
            }

        .role-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="ab-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="ab-main">
        @await Html.PartialAsync("_AdminTopbar")
        <div class="ab-content">
                <div class="page-header">
                    <div class="page-title">Add User</div>
                    <div class="page-sub">Create a new login account for an NTPC employee.</div>
                </div>

                @if (TempData["Success"] != null)
                {
                    <div class="success-alert">
                        <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                        @TempData["Success"]
                    </div>
                }

                <div class="info-box">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                    This creates a <strong>login account</strong>. The employee can sign in using their Employee Number and Password.
                </div>

                <form asp-controller="User" asp-action="AddUser" method="post">

                    <!-- ── Employee Details ── -->
                    <div class="form-card">
                        <div class="form-card-header">
                            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                            <span>Employee Details</span>
                        </div>
                        <div class="form-card-body">
                            <div class="form-grid">

                                <div class="form-group span-2">
                                    <label asp-for="Name" class="form-label">Full Name <span class="req"></span></label>
                                    <input asp-for="Name" class="form-control" placeholder="e.g. Rahul Kumar Sharma" />
                                    <span asp-validation-for="Name" class="field-error"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="EmployeeNumber" class="form-label">Employee Number <span class="req"></span></label>
                                    <input asp-for="EmployeeNumber" class="form-control" placeholder="e.g. 1001" />
                                    <span asp-validation-for="EmployeeNumber" class="field-error"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="MobileNumber" class="form-label">Mobile Number <span class="req"></span></label>
                                    <input asp-for="MobileNumber" type="tel" class="form-control"
                                           placeholder="10-digit mobile number" maxlength="10" />
                                    <span asp-validation-for="MobileNumber" class="field-error"></span>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- ── Assign Role ── -->
                    <div class="form-card">
                        <div class="form-card-header">
                            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                            <span>Assign Role <span style="color:var(--danger);margin-left:2px;">*</span></span>
                        </div>
                        <div class="form-card-body">
                            <div class="role-grid">

                                <div>
                                    <input type="radio" asp-for="Role" value="Admin" id="rAdmin" class="role-radio" />
                                    <label for="rAdmin" class="role-label">
                                        <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                                        <span class="role-name">Admin</span>
                                        <span class="role-desc">Full system access</span>
                                    </label>
                                </div>

                                <div>
                                    <input type="radio" asp-for="Role" value="Employee" id="rEmployee" class="role-radio" />
                                    <label for="rEmployee" class="role-label">
                                        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                                        <span class="role-name">Employee</span>
                                        <span class="role-desc">Can request vehicles</span>
                                    </label>
                                </div>

                            </div>
                            <span asp-validation-for="Role" class="field-error" style="display:block;margin-top:10px;"></span>
                        </div>
                    </div>

                    <!-- ── Set Password ── -->
                    <div class="form-card">
                        <div class="form-card-header">
                            <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                            <span>Login Password <span style="color:var(--danger);margin-left:2px;">*</span></span>
                        </div>
                        <div class="form-card-body">
                            <div class="form-grid">
                                <div class="form-group">
                                    <label asp-for="Password" class="form-label">Password <span class="req"></span></label>
                                    <div class="pw-wrap">
                                        <input asp-for="Password" id="pwInput" type="password"
                                               class="form-control" placeholder="Min. 4 characters" />
                                        <button type="button" class="pw-toggle" onclick="togglePw()">
                                            <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="field-error"></span>
                                </div>
                                <div style="display:flex;align-items:flex-end;padding-bottom:2px;">
                                    <div style="background:rgba(245,197,24,0.08);border:1px solid rgba(245,197,24,0.25);border-radius:10px;padding:12px 14px;font-size:12px;color:#92700a;line-height:1.6;width:100%;">
                                        🔒 Password is securely hashed.<br />
                                        Employee logs in using their<br />
                                        <strong>Employee Number + Password</strong>.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-card-footer">
                            <button type="submit" class="btn-save">
                                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12" /></svg>
                                Create User
                            </button>
                            <a asp-controller="Home" asp-action="AdminDashboard" class="btn-cancel">Cancel</a>
                        </div>
                    </div>

                </form>
           
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function togglePw() {
            const i = document.getElementById('pwInput');
            i.type = i.type === 'password' ? 'text' : 'password';
        }
    </script>
}
