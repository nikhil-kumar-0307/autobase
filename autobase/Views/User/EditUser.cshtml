@model List<autobase.Models.Entities.User>
@{
    ViewData["Title"] = "Edit User";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}
<link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
<style>
    .table-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }

    .table-toolbar {
        padding: 16px 22px;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .table-toolbar-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text);
        flex: 1;
    }

    .search-input {
        height: 36px;
        padding: 0 14px;
        background: var(--bg);
        border: 1.5px solid var(--border);
        border-radius: 8px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 13px;
        color: var(--text);
        outline: none;
        width: 220px;
        transition: border-color 0.15s;
    }

        .search-input:focus {
            border-color: var(--accent);
        }

        .search-input::placeholder {
            color: var(--muted2);
        }

    .ab-table {
        width: 100%;
        border-collapse: collapse;
    }

        .ab-table th {
            padding: 11px 18px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--muted);
            background: var(--bg);
            text-align: left;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        .ab-table td {
            padding: 13px 18px;
            font-size: 13.5px;
            color: var(--text);
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        .ab-table tbody tr:last-child td {
            border-bottom: none;
        }

        .ab-table tbody tr:hover {
            background: var(--bg);
        }

    .user-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        color: #111;
        flex-shrink: 0;
    }

    .user-name {
        font-weight: 600;
    }

    .user-emp {
        font-size: 11px;
        color: var(--muted);
        font-family: monospace;
    }

    .role-pill {
        display: inline-flex;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }

    .role-admin {
        background: rgba(168,85,247,0.1);
        color: #9333ea;
    }

    .role-driver {
        background: rgba(59,130,246,0.1);
        color: #2563eb;
    }

    .role-employee {
        background: rgba(34,197,94,0.1);
        color: #16a34a;
    }

    .btn-edit {
        height: 32px;
        padding: 0 14px;
        background: var(--accent);
        border: none;
        border-radius: 7px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 12px;
        font-weight: 700;
        color: #111;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: background 0.15s;
    }

        .btn-edit:hover {
            background: var(--accent-dark);
            color: #fff;
        }

        .btn-edit svg {
            width: 13px;
            height: 13px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .btn-add-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 38px;
        padding: 0 20px;
        background: var(--accent);
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        color: #111;
        text-decoration: none;
        transition: background 0.15s;
    }

        .btn-add-link:hover {
            background: var(--accent-dark);
            color: #fff;
        }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: var(--muted);
    }

        .empty-state svg {
            width: 48px;
            height: 48px;
            stroke: var(--muted2);
            fill: none;
            stroke-width: 1.5;
            display: block;
            margin: 0 auto 14px;
        }

    .success-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f0fff4;
        border: 1px solid #9ae6b4;
        border-radius: 10px;
        padding: 13px 16px;
        font-size: 13px;
        color: #276749;
        margin-bottom: 22px;
    }

        .success-alert svg {
            width: 15px;
            height: 15px;
            stroke: #276749;
            fill: none;
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
        }
</style>

<div class="ab-shell">
    @await Html.PartialAsync("_AdminSidebar")
    <div class="ab-main">
        @await Html.PartialAsync("_AdminTopbar")
        <div class="ab-content">

            <div class="page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
                <div>
                    <div class="page-title">Edit User</div>
                    <div class="page-sub">Update login account details for existing users.</div>
                </div>
                <a asp-controller="User" asp-action="AddUser" class="btn-add-link">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" fill="none" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
                    Add User
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="success-alert">
                    <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                    @TempData["Success"]
                </div>
            }

            <div class="table-card">
                <div class="table-toolbar">
                    <span class="table-toolbar-title">All Login Users (@Model.Count)</span>
                    <input class="search-input" type="text" placeholder="🔍 Search..."
                           oninput="filterTable(this)" />
                </div>

                @if (!Model.Any())
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /></svg>
                        <p style="margin-bottom:16px;">No users found.</p>
                        <a asp-controller="User" asp-action="AddUser" class="btn-add-link">Add First User</a>
                    </div>
                }
                else
                {
                    <table class="ab-table" id="userTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Employee No.</th>
                                <th>Mobile</th>
                                <th>Role</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in Model)
                            {
                                <tr>
                                    <td style="color:var(--muted);font-size:12px;">@u.Id</td>
                                    <td>
                                        <div class="user-cell">
                                            <div class="user-avatar">@u.Name.Substring(0, 1).ToUpper()</div>
                                            <span class="user-name">@u.Name</span>
                                        </div>
                                    </td>
                                    <td style="font-family:monospace;font-size:13px;">#@u.EmployeeNumber</td>
                                    <td style="font-family:monospace;font-size:13px;">@u.MobileNumber</td>
                                    <td>
                                        @{
                                            var rc = u.Role switch
                                            {
                                                "Admin" => "role-admin",
                                                "Driver" => "role-driver",
                                                _ => "role-employee"
                                            };
                                        }
                                        <span class="role-pill @rc">@u.Role</span>
                                    </td>
                                    <td>
                                        <a asp-controller="User" asp-action="EditUserForm"
                                           asp-route-id="@u.Id" class="btn-edit">
                                            <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable(input) {
            const q = input.value.toLowerCase();
            document.querySelectorAll('#userTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>
}
